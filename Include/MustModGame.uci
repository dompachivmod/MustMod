//SetGameType returns which game mode should be used for which map prefix
//You can do whatever you want with this. You can even use Options
// (options => the ?blah=blah things added after the map name when launching a server or in the map list)
//to add even more variety. See the ParseOption function in Src\Engine\Classes\GameInfo.uc
var config array<GameTypePrefix> SDKPrefixes;

// Local stats bridge. These values are per game-mode class in DefaultMustMod.ini.
// Keep it disabled until the Chivalry dedicated server and local backend run on
// the same machine, then configure a non-empty API key before enabling it.
var config bool bEnableStatsReporting;
var config string StatsEndpoint;
var config string StatsApiKey;
var config string StatsServerId;
var config float StatsReportInterval;

// MUSTMOD: watchdog on the tournament ready gate. Vanilla never gives up, so a gate that
// can never be satisfied leaves the server in a permanent pre-round. Turns a brick into
// a delay.
var config float fMustModTournamentHoldLimit;   // seconds before giving up; 0 disables
var float fMustModTournamentHoldSince;          // when the gate first blocked; 0 = not blocking

var string StatsMatchId;
var bool bStatsRequestInFlight;
var HttpRequestInterface StatsRequest;

// MUSTMOD: ranked mode (MustModRanked). Only MustModLTS spawns one; it is declared here so
// the shared ShouldCountDown below can consult it, and stays none in every other mode.
var MustModRanked Ranked;

// MUSTMOD: numbers-only signature of the last top-3 team-damage callout, so an unchanged
// board stays silent. Reset in StartMatch with the rest of the per-match counters.
var string LastTeamDamageSignature;

// MUSTMOD: when !rankedhelp was last shown (RealTimeSeconds); 0 = not yet this map.
var float LastRankedHelpTime;

// MUSTMOD: when !td was last shown (RealTimeSeconds); 0 = not yet this map.
var float LastTeamDamageListTime;


static event class<GameInfo> SetGameType(string MapName, string Options, string Portal)
{
    local string ThisMapPrefix;
    local int i,pos;
    local class<GameInfo> NewGameType;

    LogAlwaysInternal("SetGameType is being called on"@default.Class);

    MapName = StripPlayOnPrefix( MapName );

    // replace self with appropriate gametype if no game specified
    pos = InStr(MapName,"-");
    ThisMapPrefix = left(MapName,pos);

    for (i = 0; i < default.SDKPrefixes.length; i++)
    {
        if (default.SDKPrefixes[i].Prefix ~= ThisMapPrefix)
        {
            NewGameType = class<GameInfo>(DynamicLoadObject(default.SDKPrefixes[i].GameType, class'Class'));
            if ( NewGameType != None )
            {
                return NewGameType;
            }
        }
    }

    return super.SetGameType(MapName, Options, Portal);
}

function bool ShouldCountDown()
{
    local int AgathaSize, MasonSize;
    local int AgathaMod, MasonMod;
    local int AgathiansReady, MasonsReady;
    local int CorrectedAgathaSize, CorrectedMasonSize;
    local bool bCanSpawn;
    local bool bEachTeamHasAtleastOnePlayer;
    local bool bReadyGateOpen;

    local Controller C;
    local AOCPlayerController PC;

    // MUSTMOD: ranked holds the countdown until matchmaking has locked the teams.
    if (Ranked != none && !Ranked.AllowsCountdown())
    {
        return false;
    }

    AgathaMod = 0;
    MasonMod = 0;
    foreach WorldInfo.AllControllers(class'Controller', C)
    {
        PC = AOCPlayerController(C);
        bCanSpawn = (PC != none && PC.CurrentFamilyInfo != none && PC.bReady) || AOCAIController(C) != none;

        if(CMWTO2GRI(GameReplicationInfo) != none && AOCAIController(C) != none)
        {
            //bots cannot trigger countdown in TO2 (is breaking horde-type maps)
            continue;
        }
        
        if(!bCanSpawn)
        {
            continue;
        }

        if (AOCPRI(C.PlayerReplicationInfo).IsOnTeam(EAOCFaction(Teams[0].TeamIndex)))
        {
            AgathaSize += 1;

            if(PC.IsVoluntarySpectator())
            {
                AgathaMod += 1;
            }
            else if(PC.bTournamentReady)
            {
                AgathiansReady += 1;
            }
        }
        else if (AOCPRI(C.PlayerReplicationInfo).IsOnTeam(EAOCFaction(Teams[1].TeamIndex)))
        {
            MasonSize += 1;

            if(PC.IsVoluntarySpectator())
            {
                MasonMod += 1;
            }
            else if(PC.bTournamentReady)
            {
                MasonsReady += 1;
            }
        }
    }

    CorrectedAgathaSize = AgathaSize - AgathaMod;
    CorrectedMasonSize = MasonSize - MasonMod;

    bEachTeamHasAtleastOnePlayer = (CorrectedAgathaSize > 0 && CorrectedMasonSize > 0);

    if (bTournamentMode)
    {
        bReadyGateOpen =
        (
            bEachTeamHasAtleastOnePlayer &&
            (
                // each team has more than the minimum tolerable amount of 'ready' players
                (
                    (AgathiansReady / float(CorrectedAgathaSize)) >= TournamentTeamReadyThreshold &&
                    (MasonsReady / float(CorrectedMasonSize)) >= TournamentTeamReadyThreshold
                )

                // or an admin forced the match to start
                || bAdminForcedTournamentReady
            )
        );

        if (bReadyGateOpen)
        {
            fMustModTournamentHoldSince = 0;
            return true;
        }

        if (fMustModTournamentHoldSince == 0)
        {
            fMustModTournamentHoldSince = WorldInfo.TimeSeconds;
        }
        else if (fMustModTournamentHoldLimit > 0
                 && WorldInfo.TimeSeconds - fMustModTournamentHoldSince > fMustModTournamentHoldLimit)
        {
            // Only StartRound clears bTournamentMode, and it cannot run while this
            // returns false -- so give up rather than hold the server hostage.
            LogAlwaysInternal("[MustMod] Tournament ready gate held the pre-round for"
                @ int(fMustModTournamentHoldLimit) @ "seconds. Dropping tournament mode.");
            S_BroadcastServerMessage("Tournament mode could not start the round. Starting normally.");

            bTournamentMode = false;
            if (AOCGRI(GameReplicationInfo) != none)
                AOCGRI(GameReplicationInfo).bTournamentModeWaiting = false;
            fMustModTournamentHoldSince = 0;

            return (bEachTeamHasAtleastOnePlayer || !bWaitForTeams);
        }

        return false;
    }
    else
    {
        return (bEachTeamHasAtleastOnePlayer || !bWaitForTeams);
    }
}

// Deprecated
function AdminTournamentMode(bool bEnable){}

function UpdateVoteTally()
{
    local int VoteTimeLeft;

    switch(VoteCategory)
    {
    case EVOTECAT_KICK:
        VoteTimeLeft = Round(GetRemainingTimeForTimer('EndKickVote'));
        break;
    case EVOTECAT_ChangeMap:
        VoteTimeLeft = Round(GetRemainingTimeForTimer('EndChangeMapVote'));
        break;
    case EVOTECAT_RestartMap:
        VoteTimeLeft = Round(GetRemainingTimeForTimer('EndResetMapVote'));
        break;
    default:
        super.UpdateVoteTally();
        return;
    }

    if (VoteTimeLeft == -1)
        VoteTimeLeft = Round(GetRemainingTimeForTimer('EndCustomVote'));

    CountVotes();

    BroadcastSystemMessage(iLocVoteSecondsLeft,
        class'AOCSystemMessages'.static.CreateLocalizationdata("INVALIDDATA", String(VoteTimeLeft),""),
        class'AOCSystemMessages'.static.CreateLocalizationdata("INVALIDDATA", String(Round(100.0f * VotesYes/Float(VotesNo + VotesYes))),""),
        EFAC_ALL);
}

function bool DidVoteSucceed()
{
    local int NumVoters;

    CountVotes();
    NumVoters = VotesYes + VotesNo;

    if (Float(NumVoters) / (NumVoters + VoteAbstains) < fVoteMinAmountNonAbstainers)
    {
        BroadcastSystemMessage(iLocVoteFailedTooManyAbstain,
            class'AOCSystemMessages'.static.CreateLocalizationdata("INVALIDDATA", String(NumVoters),""),
            class'AOCSystemMessages'.static.CreateLocalizationdata("INVALIDDATA", String(NumVoters + VoteAbstains),""),
            EFAC_ALL);

        return false;
    }

    if (Float(VotesYes) / (NumVoters) <= fVoteSuccessThreshold)
    {
        BroadcastSystemMessage(iLocVoteFailedTooManyNo,
            class'AOCSystemMessages'.static.CreateLocalizationdata("INVALIDDATA", String(Round(100.0f * VotesYes/Float(VotesNo + VotesYes))),""),
            class'AOCSystemMessages'.static.CreateLocalizationdata("INVALIDDATA", String(100.0f * fVoteSuccessThreshold),""),
            EFAC_ALL);

        return false;
    }

    BroadcastSystemMessage(iLocVoteVotedYesVotedNo,
        class'AOCSystemMessages'.static.CreateLocalizationdata("INVALIDDATA", String(VotesYes),""),
        class'AOCSystemMessages'.static.CreateLocalizationdata("INVALIDDATA", String(VotesNo),""),
        EFAC_ALL);

    return true;
}

reliable server function S_BroadcastServerMessage(string Message)
{
    local AOCPlayerController PC;
    foreach WorldInfo.AllControllers(class'AOCPlayerController', PC)
    {
        PC.ReceiveChatMessage(Message, EFAC_ALL, false, false, , false);
    }
}

function int GetActualPlayersCount()
{
    local AOCPlayerController PC;
    local int PlayerCount;

    foreach WorldInfo.AllControllers(class'AOCPlayerController', PC)
    {
        if (!PC.IsVoluntarySpectator() && PC.CurrentFamilyInfo != none && PC.bReady)
            PlayerCount += 1;
    }

    return PlayerCount;
}

/**
 * MUSTMOD: periodic top-3 team-damage callout.
 *
 * Team damage has nowhere to live on the scoreboard -- AOCPRI.TeamDamageDealt is
 * repurposed for the Prys (successful parry) column. The callout reads the whole-map total
 * in MapTeamDamageDealt (MustModPRI.uci, server-only), counted from match start; it is not
 * AOCPlayerController.TeamDamageDealt, which the spawn queue zeroes on every respawn.
 *
 * Fires on a 5 minute loop started in StartMatch, and stays silent unless the three totals
 * actually moved, so a quiet round does not spam the same line every five minutes.
 */
function AnnounceTopTeamDamage()
{
    local AOCPlayerController PC;
    local `{GAMEMODE}PRI PRI;
    local array<AOCPRI> TopPRI;
    local array<int> TopTD;
    local int i, TD;
    local string Signature, Line;

    if (WorldInfo == none || WorldInfo.GRI == none)
    {
        return;
    }

    // Insertion sort, capped at three -- the list is tiny and this avoids sorting the
    // whole player array to throw away all but the top of it.
    foreach WorldInfo.AllControllers(class'AOCPlayerController', PC)
    {
        PRI = `{GAMEMODE}PRI(PC.PlayerReplicationInfo);
        if (PRI == none)
        {
            continue;
        }
        TD = PRI.MapTeamDamageDealt;

        if (TD <= 0 || PC.IsVoluntarySpectator())
        {
            continue;
        }

        for (i = 0; i < TopTD.Length; ++i)
        {
            if (TD > TopTD[i])
            {
                break;
            }
        }

        if (i < 3)
        {
            TopTD.InsertItem(i, TD);
            TopPRI.InsertItem(i, PRI);

            if (TopTD.Length > 3)
            {
                TopTD.Remove(3, TopTD.Length - 3);
                TopPRI.Remove(3, TopPRI.Length - 3);
            }
        }
    }

    if (TopTD.Length == 0)
    {
        return;
    }

    // Compare on the numbers only, per the rule: the callout repeats only when someone's
    // total actually changed. Two players swapping places on identical totals is not a
    // change worth announcing.
    for (i = 0; i < TopTD.Length; ++i)
    {
        Signature $= string(TopTD[i]) $ "|";
    }

    if (Signature == LastTeamDamageSignature)
    {
        return;
    }

    LastTeamDamageSignature = Signature;

    // One line, and no leading whitespace. AOCGame.BroadcastMessage strips a message that
    // starts with a space (Left(Message,1) == " " -> Split), so an indented list silently
    // loses its indent; and four separate broadcasts every five minutes is a lot of chat.
    Line = "Top team damage:";

    for (i = 0; i < TopTD.Length; ++i)
    {
        if (i > 0)
        {
            Line $= ",";
        }

        Line $= " " $ string(i + 1) $ ". " $ TopPRI[i].PlayerName $ " " $ string(TopTD[i]);
    }

    BroadcastMessage(none, Line, EFAC_ALL, true, true, "#D1A04A");
}

function ResetParryScoreboardCounts()
{
    local int i;
    local AOCPRI PRI;
    local `{GAMEMODE}PRI ModPRI;

    if (WorldInfo == none || WorldInfo.GRI == none)
    {
        return;
    }

    for (i = 0; i < WorldInfo.GRI.PRIArray.Length; ++i)
    {
        PRI = AOCPRI(WorldInfo.GRI.PRIArray[i]);
        if (PRI != none)
        {
            PRI.TeamDamageDealt = 0;
        }

        // Whole-map team damage counts from match start, not from warmup.
        ModPRI = `{GAMEMODE}PRI(PRI);
        if (ModPRI != none)
        {
            ModPRI.MapTeamDamageDealt = 0;
        }
    }
}

/**
 * MUSTMOD: runs for every player on every map -- from PostLogin when they join, and from
 * HandleSeamlessTravelPlayer when a map change or restart carries them over -- in every
 * mode. Hosts the "!rankedhelp" hint and the ranked join hook.
 */
function GenericPlayerInitialization(Controller C)
{
    local string StrippedName;

    super.GenericPlayerInitialization(C);

    // Delayed so the client's HUD exists by then; a chat line sent earlier is dropped.
    if (AOCPlayerController(C) != none)
    {
        C.SetTimer(8.0, false, 'MustModShowRankedHint');
    }

    if (Ranked != none && Ranked.IsConfigured())
    {
        Ranked.PlayerJoined(C);
    }
    else if (C.PlayerReplicationInfo != none)
    {
        // An Elo tag carried over from an LTS map means nothing in other modes, so put the
        // player's own name back.
        StrippedName = class'MustModRanked'.static.StripEloTag(C.PlayerReplicationInfo.PlayerName);
        if (StrippedName != C.PlayerReplicationInfo.PlayerName)
        {
            ChangeName(C, StrippedName, false);
        }
    }
}

// MUSTMOD: a finished map plays again instead of moving on in the map rotation. MatchOver
// waits the usual time and calls RestartGame, which travels to whatever this returns;
// "?restart" reloads the current map with its URL options (modname and so on) intact.
// Admin map changes and map votes travel directly and are unaffected.
function string GetNextMap()
{
    return "?restart";
}

function StartMatch()
{
    ResetParryScoreboardCounts();
    LastTeamDamageSignature = "";
    SetTimer(300.0, true, 'AnnounceTopTeamDamage');
    super.StartMatch();

    BeginStatsReporting();

    // MUSTMOD: make catapults permanently destructible (see DisableCatapultRespawns). One
    // immediate pass covers catapults already on the map, and a low-frequency looping sweep
    // catches any destroyed or Kismet-spawned later in the round.
    DisableCatapultRespawns();
    SetTimer(3.0, true, 'DisableCatapultRespawns');

    // MUSTMOD: disable siege weapons and non-objective gates on Slumforest only.
    // Objective-tied AOCInterpActor instances (e.g. Darkforest doors, peasant gates) are
    // excluded via IsPartOfObjective(). Repeated on a timer to catch Kismet-spawned actors.
    // DisableSiegeObjects();
    // SetTimer(3.0, true, 'DisableSiegeObjects');
}

function BeginStatsReporting()
{
    if (!bEnableStatsReporting || StatsEndpoint == "" || StatsApiKey == "" || StatsServerId == "")
    {
        return;
    }

    // Map names and the server's elapsed time are engine-produced, safe identifier
    // components. This ID stays stable for all snapshots in the current match.
    StatsMatchId = WorldInfo.GetMapName() $ "-" $ string(int(WorldInfo.TimeSeconds));
    ClearTimer('SendStatsSnapshot');
    SendStatsSnapshot();
    SetTimer(FMax(10.0, StatsReportInterval), true, 'SendStatsSnapshot');
}

function SendStatsSnapshot()
{
    local string Payload;

    if (!bEnableStatsReporting || bStatsRequestInFlight || StatsMatchId == "")
    {
        return;
    }

    Payload = BuildStatsPayload();
    StatsRequest = class'HttpFactory'.static.CreateRequest();
    if (StatsRequest == none)
    {
        LogAlwaysInternal("SlumpMod stats: failed to create HTTP request.");
        return;
    }

    bStatsRequestInFlight = true;
    StatsRequest.SetURL(StatsEndpoint $ "?key=" $ StatsApiKey);
    StatsRequest.SetVerb("POST");
    StatsRequest.SetHeader("Content-Type", "application/json");
    StatsRequest.SetContentAsString(Payload);
    StatsRequest.SetProcessRequestCompleteDelegate(StatsRequestComplete);
    StatsRequest.ProcessRequest();
}

function string BuildStatsPayload()
{
    local string Quote;

    Quote = Chr(34);
    return "{" $
        Quote $ "matchId" $ Quote $ ":" $ Quote $ StatsMatchId $ Quote $ "," $
        Quote $ "serverId" $ Quote $ ":" $ Quote $ StatsServerId $ Quote $ "," $
        Quote $ "map" $ Quote $ ":" $ Quote $ WorldInfo.GetMapName() $ Quote $ "," $
        Quote $ "elapsedSeconds" $ Quote $ ":" $ string(int(WorldInfo.TimeSeconds)) $ "," $
        Quote $ "players" $ Quote $ ":" $ BuildStatsPlayersJson() $
        "}";
}

function string BuildStatsPlayersJson()
{
    local `{GAMEMODE}PRI ModPRI;
    local int i;
    local int TeamIndex;
    local string Quote;
    local string Result;

    Quote = Chr(34);
    Result = "[";

    if (WorldInfo == none || WorldInfo.GRI == none)
    {
        return Result $ "]";
    }

    for (i = 0; i < WorldInfo.GRI.PRIArray.Length; ++i)
    {
        ModPRI = `{GAMEMODE}PRI(WorldInfo.GRI.PRIArray[i]);
        if (ModPRI == none || ModPRI.bBot)
        {
            continue;
        }

        if (ModPRI.Team != none)
        {
            TeamIndex = ModPRI.Team.TeamIndex;
        }
        else
        {
            TeamIndex = -1;
        }

        if (Result != "[")
        {
            Result $= ",";
        }

        Result $= "{" $
            Quote $ "idA" $ Quote $ ":" $ string(ModPRI.UniqueId.Uid.A) $ "," $
            Quote $ "idB" $ Quote $ ":" $ string(ModPRI.UniqueId.Uid.B) $ "," $
            Quote $ "team" $ Quote $ ":" $ string(TeamIndex) $ "," $
            Quote $ "kills" $ Quote $ ":" $ string(ModPRI.NumKills) $ "," $
            Quote $ "deaths" $ Quote $ ":" $ string(ModPRI.Deaths) $ "," $
            Quote $ "assists" $ Quote $ ":" $ string(ModPRI.NumAssists) $ "," $
            Quote $ "enemyDamage" $ Quote $ ":" $ string(ModPRI.EnemyDamageDealt) $ "," $
            Quote $ "teamDamage" $ Quote $ ":" $ string(ModPRI.TeamDamageDealt) $ "," $
            Quote $ "damageTaken" $ Quote $ ":" $ string(ModPRI.AllDamageTaken) $ "," $
            Quote $ "parries" $ Quote $ ":" $ string(ModPRI.Parries) $ "," $
            Quote $ "feints" $ Quote $ ":" $ string(ModPRI.Feints) $ "," $
            Quote $ "meleeHits" $ Quote $ ":" $ string(ModPRI.MeleeHits) $ "," $
            Quote $ "projectileHits" $ Quote $ ":" $ string(ModPRI.ProjectileHits) $ "," $
            Quote $ "blocks" $ Quote $ ":" $ string(ModPRI.Blocks) $ "," $
            Quote $ "dodges" $ Quote $ ":" $ string(ModPRI.Dodges) $
            "}";
    }

    return Result $ "]";
}

function StatsRequestComplete(HttpRequestInterface Request, HttpResponseInterface Response, bool bWasSuccessful)
{
    bStatsRequestInFlight = false;

    if (!bWasSuccessful)
    {
        LogAlwaysInternal("SlumpMod stats: snapshot upload failed for" @ StatsMatchId);
    }
}


exec function TournamentMode(bool bEnable)
{
    if (default.bTournamentMode == bEnable)
        return;

    S_BroadcastServerMessage("Admin TournamentMode");

    ConfigureTournamentMode(bEnable);
    WorldInfo.ServerTravel("?restart", false);
}

reliable server function ConfigureTournamentMode(bool bEnable)
{
    bTournamentMode = bEnable;
    SaveConfig();

    class'AOCGame'.default.bTournamentMode = bEnable;
    class'AOCGame'.static.StaticSaveConfig();
}

/**
 * Enforce admin mute server-side instead of trusting the client.
 *
 * Vanilla only checks bIsAdminMuted in AOCPlayerController.ReceiveChatMessage, and skips it
 * for Steam friends of the sender and for the sender's own copy -- so a muted player still
 * sees their chat go through, which looks exactly like mute being broken. Dropping it here
 * means it never reaches the wire.
 */
function BroadcastMessage(PlayerController Sender, string Message, EAOCFaction DesignatedTeam, optional bool bSystemMessage = false, optional bool bUseCustomColor = false, optional string Col)
{
    local AOCPRI SenderPRI;
    local AOCPlayerController SenderPC;

    SenderPC = AOCPlayerController(Sender);

    if (!bSystemMessage && SenderPC != none)
    {
        SenderPRI = AOCPRI(SenderPC.PlayerReplicationInfo);
        if (SenderPRI != none && SenderPRI.bIsAdminMuted)
        {
            // Tell the sender only, so mute is not silently confusing to them.
            SenderPC.ReceiveChatMessage("You are muted by an admin.", EFAC_ALL, false, true, "#FF5555");
            return;
        }
    }

    // MUSTMOD: "!rankedhelp" shows the help to everyone, at most once per 30s server-wide.
    // The typed line itself is never shown; inside the cooldown it is silently dropped.
    // Spaces are stripped first, so " !rankedhelp " and "!rankedhelp" both count.
    if (!bSystemMessage && SenderPC != none && Locs(Repl(Message, " ", "")) == "!rankedhelp")
    {
        if (LastRankedHelpTime == 0 || WorldInfo.RealTimeSeconds - LastRankedHelpTime >= 30.0)
        {
            LastRankedHelpTime = WorldInfo.RealTimeSeconds;
            SendRankedHelp(SenderPC);
        }
        return;
    }

    // MUSTMOD: "!td" shows everyone's team damage to everyone, at most once per 60s
    // server-wide. The typed line is never shown; inside the cooldown only the sender is
    // told how long is left. Same normalising as above.
    if (!bSystemMessage && SenderPC != none && Locs(Repl(Message, " ", "")) == "!td")
    {
        if (LastTeamDamageListTime == 0 || WorldInfo.RealTimeSeconds - LastTeamDamageListTime >= 60.0)
        {
            LastTeamDamageListTime = WorldInfo.RealTimeSeconds;
            SendTeamDamageList();
        }
        else
        {
            SenderPC.ReceiveChatMessage("!td can be used again in" @ int(60.0 - (WorldInfo.RealTimeSeconds - LastTeamDamageListTime) + 1) $ "s.", EFAC_ALL, false, true, "#D1A04A");
        }
        return;
    }

    // MUSTMOD: ranked surrender vote, "!ff" then "!yes" / "!no". Same normalising as above.
    if (!bSystemMessage && SenderPC != none && Ranked != none && Ranked.HandleChatCommand(SenderPC, Locs(Repl(Message, " ", ""))))
    {
        return;
    }

    super.BroadcastMessage(Sender, Message, DesignatedTeam, bSystemMessage, bUseCustomColor, Col);
}

/**
 * MUSTMOD: the !td reply, shown to everyone. Every player in the game (spectators left out),
 * highest team damage first, one line each. Reads the whole-map MapTeamDamageDealt, the same
 * total as the 5-minute top-3 callout (see AnnounceTopTeamDamage).
 */
function SendTeamDamageList()
{
    local AOCPlayerController PC;
    local `{GAMEMODE}PRI PRI;
    local array<`{GAMEMODE}PRI> Sorted;
    local array<string> Lines;
    local string Line;
    local int i;

    // Insertion sort, highest first; ties keep join order.
    foreach WorldInfo.AllControllers(class'AOCPlayerController', PC)
    {
        PRI = `{GAMEMODE}PRI(PC.PlayerReplicationInfo);
        if (PRI == none || PC.IsVoluntarySpectator())
        {
            continue;
        }

        for (i = 0; i < Sorted.Length; ++i)
        {
            if (PRI.MapTeamDamageDealt > Sorted[i].MapTeamDamageDealt)
            {
                break;
            }
        }
        Sorted.InsertItem(i, PRI);
    }

    if (Sorted.Length == 0)
    {
        Lines.AddItem("Team damage: no players.");
    }
    else
    {
        Lines.AddItem("Team damage this map:");
        for (i = 0; i < Sorted.Length; ++i)
        {
            // No leading spaces: chat strips them (see AnnounceTopTeamDamage).
            Lines.AddItem(string(i + 1) $ ". " $ Sorted[i].PlayerName $ " " $ string(Sorted[i].MapTeamDamageDealt));
        }
    }

    foreach WorldInfo.AllControllers(class'AOCPlayerController', PC)
    {
        foreach Lines(Line)
        {
            PC.ReceiveChatMessage(Line, EFAC_ALL, false, true, "#D1A04A");
        }
    }
}

/**
 * MUSTMOD: the !rankedhelp reply, shown to everyone. The admin commands go to the admin who
 * asked only -- they are no use to anyone else.
 */
function SendRankedHelp(AOCPlayerController Asker)
{
    local array<string> Lines;
    local string Line;
    local AOCPlayerController PC;

    if (Ranked == none)
    {
        Lines.AddItem("Ranked is played on LTS maps only.");
    }
    else
    {
        Lines.AddItem("Ranked is" @ (Ranked.bRankedEnabled ? "ON" : "OFF") @ "on this server.");
    }
    Lines.AddItem("To play: while ranked is on, pick a team and class on an LTS map to queue.");
    Lines.AddItem("Any even number of players makes a match (2v2, 3v3, ...); it starts 30s after enough join.");
    Lines.AddItem("Elo moves 6 per round of margin in an even match (7-5 = 12), more for an upset, less for a favourite.");
    Lines.AddItem("!ff in chat (after 4 rounds): your team votes to surrender with !yes / !no. Over 60% yes ends the match after the current round; you lose by your round deficit + 1.");
    Lines.AddItem("voteranked (console): start a vote to turn ranked on.");
    Lines.AddItem("voteunranked (console): start a vote to turn it off (between matches).");

    foreach WorldInfo.AllControllers(class'AOCPlayerController', PC)
    {
        foreach Lines(Line)
        {
            PC.ReceiveChatMessage(Line, EFAC_ALL, false, true, class'MustModRanked'.const.CHAT_COLOUR, false);
        }
    }

    if (Asker.PlayerReplicationInfo != none && Asker.PlayerReplicationInfo.bAdmin)
    {
        Lines.Length = 0;
        Lines.AddItem("Admin: admin RankedMode 1|0 -- turn ranked on/off.");
        Lines.AddItem("Admin: adminstartmatch -- start now with an even number queued (any size).");
        Lines.AddItem("Admin: adminterminatematch -- end the ranked match, no Elo changes.");
        Lines.AddItem("Admin: admin RankedExtend [seconds] / admin RankedAbandon -- during a leaver pause.");
        Lines.AddItem("Admin: admin RankedMinTeamSize <n> / admin RankedMaxTeamSize <n> -- match size limits, per side.");
        Lines.AddItem("Admin: admindisablerat 1|0 -- no Man-at-Arms in ranked matches (current ones respawn as Knight with Longsword).");

        foreach Lines(Line)
        {
            Asker.ReceiveChatMessage(Line, EFAC_ALL, false, true, class'MustModRanked'.const.CHAT_COLOUR, false);
        }
    }
}

/**
 * Spawn MustMod's remote console instead of the vanilla one. AOCGame.InitRemoteConsole
 * hardcodes Spawn(class'AOCRCon'), so this is the only hook needed -- MustModRCon extends
 * AOCRCon, so vanilla opcodes, auth and the GameEvent_* calls keep working untouched.
 * The AllActors sweep and dedicated-server check are vanilla's, kept verbatim.
 */
function InitRemoteConsole(string Options)
{
	local AOCRCon RCon;

	if (WorldInfo.NetMode != NM_DedicatedServer)
		return;

	// Reuse the console carried over from before the map change, if there is one.
	// Sessions are AOCRCon subclasses too, so skip them -- adopting one as RemoteConsole
	// would point the whole server's event stream at a single client's socket.
	foreach WorldInfo.AllActors(class'AOCRCon', RCon)
	{
		if (MustModRConSession(RCon) != none)
			continue;

		RemoteConsole = RCon;
		break;
	}

	if (RemoteConsole == none)
	{
		RemoteConsole = Spawn(class'MustModRCon');
		LogAlwaysInternal("[MustModRCon] remote console started (extended opcodes 23-64 available)");
	}

	// The travel-time push reported the map being left, so announce the real one now that
	// it is current. Sessions survive travel, so this reaches everyone already connected.
	RemoteConsole.GameEvent_MapChanged(GetCurrentMap(), MapCycleIndex);
}

/**
 * Carry the RCON sessions across a seamless map change, not just the listener. Without
 * this the session actors are destroyed with the old world and every connected client
 * drops on each map change.
 *
 * Only does anything if the travel is actually seamless -- a full ServerTravel tears down
 * the world regardless, and clients must reconnect.
 */
function GetSeamlessTravelActorList(bool bToEntry, out array<Actor> ActorList)
{
	local MustModRCon Listener;
	local int i;

	super.GetSeamlessTravelActorList(bToEntry, ActorList);

	Listener = MustModRCon(RemoteConsole);
	if (Listener == none)
		return;

	ActorList[ActorList.Length] = Listener;

	for (i = 0; i < Listener.Sessions.Length; i++)
	{
		if (Listener.Sessions[i] != none)
			ActorList[ActorList.Length] = Listener.Sessions[i];
	}

	LogAlwaysInternal("[MustModRCon] carrying" @ Listener.Sessions.Length @ "session(s) through travel");
}

DefaultProperties
{
    // Five minutes. Long enough that a real match night never trips it, short enough that a
    // stuck server recovers on its own instead of needing a restart. 0 disables.
    fMustModTournamentHoldLimit=300.0

    PlayerControllerClass=class'`{GAMEMODE}PlayerController'
    DefaultPawnClass=class'`{GAMEMODE}Pawn'
    HUDType=class'`{GAMEMODE}HUD'
    PlayerReplicationInfoClass=class'`{GAMEMODE}PRI'

    // "addbots" bot AI: smarter melee bots (skill floor + better threat awareness).
    // See MustMod/Classes/MustModAOCCombatBot.uc. Shared by every MustMod game mode.
    DefaultAIControllerClass=class'MustModAOCCombatBot'

    //This is the name that shows in the server browser for this mod:
    ModDisplayString="MustMod"

    Families.Empty;
    Families(ECLASS_Archer)=class'MustModFamilyInfo_Agatha_Archer'
    Families(ECLASS_ManAtArms)=class'MustModFamilyInfo_Agatha_ManAtArms'
    Families(ECLASS_Vanguard)=class'MustModFamilyInfo_Agatha_Vanguard'
    Families(ECLASS_Knight)=class'MustModFamilyInfo_Agatha_Knight'
    Families(ECLASS_SiegeEngineer)=class'MustModFamilyInfo_Agatha_Assassin'
    Families(5)=class'MustModFamilyInfo_Mason_Archer'
    Families(6)=class'MustModFamilyInfo_Mason_ManAtArms'
    Families(7)=class'MustModFamilyInfo_Mason_Vanguard'
    Families(8)=class'MustModFamilyInfo_Mason_Knight'
    Families(9)=class'MustModFamilyInfo_Mason_Assassin'

    MinimumRespawnTime = 10.0f
    MaximumRespawnTime = 10.0f
    bDisableTeamDamagePenalty = true

    bEnableStatsReporting = false
    StatsEndpoint = "http://127.0.0.1:3000/api/SlumpStats"
    StatsServerId = "local-chivalry"
    StatsReportInterval = 30.0

}

// MUSTMOD: Make catapults permanently destructible — once broken they stay a broken wreck for
// the rest of the round instead of self-repairing.
//
// Catapults (AOCSWCatapult) are placed directly in maps as the AOC class, so we can't subclass
// them without editing every map. Instead we reach the live instances from the game mode. In
// AOCSW_Base.TakeDamage a destroyed siege weapon schedules its own respawn via
// SetTimer(RepairTime, false, 'Repair'); Repair() then clears bDestroyed, restores Health and
// returns it to Idle. We defeat that two ways:
//   (a) push RepairTime far out so any FUTURE destruction won't repair within a round, and
//   (b) ClearTimer('Repair') on any catapult that is ALREADY destroyed, cancelling an in-flight
//       respawn (RepairTime captured at SetTimer time, so bumping it isn't enough on its own).
// A destroyed catapult's bDestroyed stays true, so TakeDamage no-ops and clients keep showing
// the broken-down wreck. Scoped to catapults only; ballistae keep vanilla respawn behaviour.
//
// This replaces the old per-frame Tick that zeroed catapult-rock velocity — that hack mutated a
// replicated projectile server-side every frame, which is what produced the "invisible shot
// lands next to the catapult" desync. Rocks now fly their normal arc; catapults are balanced by
// staying dead once destroyed instead.
function DisableCatapultRespawns()
{
	local AOCSWCatapult Catapult;
    local AOCSWBallista Ballista;

	foreach WorldInfo.AllActors(class'AOCSWCatapult', Catapult)
	{
		Catapult.RepairTime = 1000000.0;
		if (Catapult.bDestroyed)
			Catapult.ClearTimer('Repair');
	}

	foreach WorldInfo.AllActors(class'AOCSWBallista', Ballista)
	{
		Ballista.RepairTime = 1000000.0;
		if (Ballista.bDestroyed)
			Ballista.ClearTimer('Repair');
	}
}

// ---------------------------------------------------------------------------
// MUSTMOD: Disable ballistae, catapults, and non-objective gates on Slumforest.
//
// Ballistae / catapults: set health to zero and prevent repair so they stay as
// broken wrecks (or are already destroyed).
//
// Gates (AOCInterpActor): hide and disable collision UNLESS the actor is
// referenced by an AOCObjective_Breakable (i.e. the Darkforest peasant doors).
// Objective-tied breakables are left alone so the map's Kismet logic works.
// ---------------------------------------------------------------------------
function DisableSiegeObjects()
{
	local AOCSWBallista Ballista;
	local AOCSWCatapult Catapult;
	local AOCInterpActor InterpActor;

	// Only apply on Slumforest — completely inert on every other map.
	if (InStr(WorldInfo.GetMapName(), "AOCTO-Slumforest_p", false, true) == INDEX_NONE)
		return;

	// Ballistae: zero out health, kill any in-flight repair timer.
	foreach WorldInfo.AllActors(class'AOCSWBallista', Ballista)
	{
		Ballista.RepairTime = 1000000.0;
		if (Ballista.bDestroyed)
			Ballista.ClearTimer('Repair');
		Ballista.Health = 0;
	}

	// Catapults: same treatment.
	foreach WorldInfo.AllActors(class'AOCSWCatapult', Catapult)
	{
		Catapult.RepairTime = 1000000.0;
		if (Catapult.bDestroyed)
			Catapult.ClearTimer('Repair');
		Catapult.Health = 0;
	}

	// Gates / breakable objects: only hide the ones NOT tied to an objective.
	// Objective-tied actors (e.g. Darkforest final-stage doors) must remain
	// intact so the map's Kismet objective sequence can still function.
	foreach WorldInfo.AllActors(class'AOCInterpActor', InterpActor)
	{
		if (!IsPartOfObjective(InterpActor))
		{
			InterpActor.SetHidden(true);
			InterpActor.SetCollision(false, false);
		}
	}
}

function bool IsPartOfObjective(AOCInterpActor CheckActor)
{
	local AOCObjective_Breakable Obj;

	foreach WorldInfo.AllActors(class'AOCObjective_Breakable', Obj)
	{
		if (Actor(Obj.DestroyObject) == CheckActor)
			return true;
	}

	return false;
}
