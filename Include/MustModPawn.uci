/** Apply shield color picker values to the helmet material's PatternColor params */
simulated function ApplyShieldColorsToHelmet()
{
	local MaterialInstanceConstant HelmetMIC;
	local LinearColor LinCol;
	local EAOCFaction TeamID;

	if (WorldInfo.NetMode == NM_DedicatedServer)
		return;

	if (HelmetMeshComp == none || HelmetMeshComp.GetMaterial(0) == none)
		return;

	HelmetMIC = HelmetMeshComp.CreateAndSetMaterialInstanceConstant(0);
	if (HelmetMIC == none)
		return;

	TeamID = GetCustomizationFactionFromActualFaction(PawnFamily.FamilyFaction);

	LinCol = CustomizationClass.static.ConvertTabardColorIndexToLinearColor(PawnInfo.myCustomization.ShieldColor1, TeamID, 0);
	HelmetMIC.SetVectorParameterValue('PatternColor1', LinCol);

	LinCol = CustomizationClass.static.ConvertTabardColorIndexToLinearColor(PawnInfo.myCustomization.ShieldColor2, TeamID, 1);
	HelmetMIC.SetVectorParameterValue('PatternColor2', LinCol);

	LinCol = CustomizationClass.static.ConvertTabardColorIndexToLinearColor(PawnInfo.myCustomization.ShieldColor3, TeamID, 2);
	HelmetMIC.SetVectorParameterValue('PatternColor3', LinCol);
}

/** Override SetupHelmet to apply shield colors to painted helmet materials on spawn/asset load */
simulated function SetupHelmet(int HelmetID, int CharacterID)
{
	super.SetupHelmet(HelmetID, CharacterID);
	ApplyShieldColorsToHelmet();
}

/** Override to also refresh helmet colors whenever shield colors are updated (e.g. customization preview) */
simulated function DisplayCustomizationInfoOnShield()
{
	super.DisplayCustomizationInfoOnShield();
	ApplyShieldColorsToHelmet();
}

simulated function WeaponAttachmentChanged()
{
	super.WeaponAttachmentChanged();

	if (CurrentWeaponAttachment == none)
		return;

	// Force PoleAxeBack to use its own mesh on ALL clients.
	// WeaponEquipping::BeginState runs only on authority/local clients;
	// remote clients get the attachment via replication and need this hook
	// to apply the correct skeletal mesh.
	if (CurrentWeaponAttachment.Class == class'MustModWeaponAttachment_PoleAxeBack')
	{
		CurrentWeaponAttachment.Mesh.SetSkeletalMesh(
			SkeletalMesh'SlumpWep_PaxeBack.SlumpWep_PaxeBack');
		if (CurrentWeaponAttachment.OverlayMesh != none)
			CurrentWeaponAttachment.OverlayMesh.SetSkeletalMesh(
				SkeletalMesh'SlumpWep_PaxeBack.SlumpWep_PaxeBack');
	}

	// MUSTMOD: Fix heater shield orientation for javelin — javelin animations
	// hold the arm differently, causing the heater to face skyward like a saucer.
	// Rotate it 90° around Y (yaw) so the shield face points outward instead of upward.
	// if (Weapon != none && StateVariables.bShieldEquipped
	// 	&& (MustModWeapon_JavelinMelee(Weapon) != none || MustModWeapon_HeavyJavelinMelee(Weapon) != none))
	// {
	// 	ShieldMesh.SetRotation(rot(16384, 0, 0));  // 90° yaw — rotates shield face outward
	// 	if (OverlayShieldMesh != none)
	// 		OverlayShieldMesh.SetRotation(rot(16384, 0, 0));
	// }
}

/** Check if a pawn is currently in a riposte (for flinch immunity) */
simulated function bool IsInRiposte(Pawn CheckPawn) {
	local AOCMeleeWeapon MeleeWep;
	local MustModPawn BangPawn;
	
	if (CheckPawn == none || CheckPawn.Weapon == none)
		return false;
		
	MeleeWep = AOCMeleeWeapon(CheckPawn.Weapon);
	if (MeleeWep == none)
		return false;
	
	// Check if actively in riposte release state
	if (CheckPawn.Weapon.IsInState('Release') && MeleeWep.bParryHitCounter)
		return true;
	
	// Check if in riposte windup state
	if (CheckPawn.Weapon.IsInState('ParryRelease') && MeleeWep.bParryHitCounter)
		return true;
	
	// Damage grace period disabled.
	// BangPawn = MustModPawn(CheckPawn);
	// if (BangPawn != none && MeleeWep.bParryHitCounter 
	// 	&& (WorldInfo.TimeSeconds - BangPawn.fLastParrySuccessTime) <= BangPawn.fRiposteGracePeriod)
	// 	return true;
	
	return false;
}

simulated function bool ShouldActivateFlinch(HitInfo Info, class<AOCWeapon> UsedWeapon) {
	// If the weapon is set never to flinch, don't flinch
	if (UsedWeapon.default.bNeverFlinch)
		return false;

	// Don't flinch javelin
	if (AOCWeapon_JavelinThrow(Info.HitActor.Weapon) != none)
		return false;

	// Smokepots and oil pots shouldn't flinch when they hit people
	if (AOCWeapon_SmokePot(Info.Instigator.Weapon) != none || AOCWeapon_OilPot(Info.Instigator.Weapon) != none)
		return false;

	// Don't flinch during release of riposte
	if (AOCMeleeWeapon(Info.HitActor.Weapon) != none
		&& Info.HitActor.Weapon.IsInState('Release')
		&& AOCMeleeWeapon(Info.HitActor.Weapon).bParryHitCounter == true
	)
		return false;

	// Don't flinch during the windup of riposte
	if (AOCMeleeWeapon(Info.HitActor.Weapon) != none
		&& Info.HitActor.Weapon.IsInState('ParryRelease')
		&& AOCMeleeWeapon(Info.HitActor.Weapon).bParryHitCounter == true
	)
		return false;

	// Damage grace period disabled.
	// if (AOCMeleeWeapon(Info.HitActor.Weapon) != none
	// 	&& AOCMeleeWeapon(Info.HitActor.Weapon).bParryHitCounter == true
	// 	&& MustModPawn(Info.HitActor) != none
	// 	&& (WorldInfo.TimeSeconds - MustModPawn(Info.HitActor).fLastParrySuccessTime) <= MustModPawn(Info.HitActor).fRiposteGracePeriod
	// )
	// 	return false;
	
	// Fallback: If bParryHitCounter is true, always grant immunity (strongest protection)
	// This catches edge cases where grace period fails or pawn cast fails
	if (AOCMeleeWeapon(Info.HitActor.Weapon) != none
		&& AOCMeleeWeapon(Info.HitActor.Weapon).bParryHitCounter == true
	)
		return false;


	// If the weapon is in any of the following states, activate flinch
	if (Info.HitActor.Weapon.IsInState('Deflect')
		|| Info.HitActor.Weapon.IsInState('Feint')
		|| (Info.HitActor.Weapon.IsInState('Windup') && AOCRangeWeapon(Info.HitActor.Weapon) == none)
		|| (Info.HitActor.Weapon.IsInState('Release') && AOCRangeWeapon(Info.HitActor.Weapon) == none)
		|| Info.HitActor.Weapon.IsInState('Active')
		|| Info.HitActor.Weapon.IsInState('Flinch')
		|| Info.HitActor.Weapon.IsInState('Transition')
		|| Info.HitActor.StateVariables.bIsManualJumpDodge
		|| (Info.HitActor.Weapon.IsInState('Recovery') && AOCWeapon(Info.HitActor.Weapon).GetFlinchAnimLength(true) >= WeaponAnimationTimeLeft())
		|| Info.HitActor.Weapon.IsInState('WeaponEquipping')
		|| Info.HitActor.Weapon.IsInState('WeaponPuttingDown')
		|| AOCInventoryManager(InvManager).bCanSwitchWeapons == false
	) {
		return true;
	}

	// If the user is holdig a projectile, activate flinch
	if (AOCRangeWeapon(Info.HitActor.Weapon) != none)
		return true;

	// Otherwise return false
	return false;
}

function RegenHealth() {
	// No need to run this on the server
	if(Role != ROLE_Authority)
		return;

	// Don't regen if sprinting, burning or other factors
	if (!bCanHealthRegen || bIsBurning || StateVariables.bIsSprinting) {
		PauseHealthRegeneration(true);
		return;
	}

	// If idle, regenerate with an interval of 0.4s
	if (PawnState == ESTATE_IDLE && PawnInfo.myFamily.ClassReference != ECLASS_KING) {
		RegenInterval = 0.4;
		RestartHealthRegen();
	}

	// If walking/running, regenerate with an interval of 1.0s
	if (PawnState == ESTATE_RUN) {
		RegenInterval = 1.0;
		RestartHealthRegen();
	}

	// Don't regen beyond the maximum health
	if (Health != HealthMax)
		HealDamage(HealAmount, Controller, none);

	// Replicate this to other players
	if (PlayerReplicationInfo != none) {
		if (AOCPRI(PlayerReplicationInfo).CurrentHealth != Health)  {
			AOCPRI(PlayerReplicationInfo).CurrentHealth = Health;
			AOCPRI(PlayerReplicationInfo).bForceNetUpdate = true;
		}
	}
}

