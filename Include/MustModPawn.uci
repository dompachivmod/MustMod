	rott.Yaw = 150;
	rott.Pitch = -2500;
	//FaceRotation(rott, DeltaTime);
	OwnerAimNode.Aim.Y = 1551;
	OwnerAimNode.Aim.X = 2155;
	AimNode.Aim.X = 1551;
	AimNode.Aim.Y = 2155;
	SetRotation(rott);
	super.Tick( DeltaTime );
	//FaceRotation(rott, DeltaTime);
	OwnerAimNode.Aim.Y = 1551;
	OwnerAimNode.Aim.X = 2155;
	AimNode.Aim.X = 1551;
	AimNode.Aim.Y = 2155;
} */


//
//GIRU Trade Fix
//Override

unreliable client function LogHitTime(float funcTime)
{
	if (bShowHitTime)
		AOCPlayerController(Controller).ClientDisplayConsoleMessage("Your swing hit " @string(funcTime) @"seconds after release");
}

// MUSTMOD: Thin dispatcher. Validates the swing once on RPC arrival, then either holds it
// (so an in-flight parry can suppress it before any feedback plays) or resolves it immediately.
// 'self' is the ATTACKER; Info.HitActor is the defender.
reliable server function AttackOtherPawn(HitInfo Info, string DamageString, optional bool bCheckParryOnly = false, optional bool bBoxParrySuccess, optional bool bHitShield = false, optional SwingTypeImpactSound LastHit = ESWINGSOUND_Slash, optional bool bQuickKick = false)
{
	local PlayerReplicationInfo PRI;
	local MustModPawn DefenderBM;
	local float fHold;
	local PendingHit NewPending;
	local float fHitActionServerTime;

	if (PlayerReplicationInfo == none)
		PRI = Info.PRI;
	else
		PRI = PlayerReplicationInfo;
	Info.PRI = PRI;

	// MUSTMOD: Map this swing's client hit-moment stamp (sent just before us by ServerStampHitTime)
	// onto our timeline for trade ordering, then consume it so a later stampless swing falls back
	// to ping reconstruction instead of reusing a stale value.
	fHitActionServerTime = ReconstructActionTime(fPendingHitClientTime);
	fPendingHitClientTime = 0.0;

	LogHitTime(WorldInfo.TimeSeconds - fLastReleaseStartTime - 0.0087);

	// Block attacks while the attacker is flinched (no trade window)
	if (MustModMeleeWeapon(Weapon) != none && MustModMeleeWeapon(Weapon).IsInState('Flinch'))
		return;

	// Authority / lag-comp validation happens once, when the swing RPC arrives.
	if (!PerformAttackSSSC(Info) && WorldInfo.NetMode != NM_Standalone)
		return;

	// Decide whether to HOLD this swing so an in-flight parry can suppress it before any
	// feedback plays. Only enemy melee swings that would land as a hit are eligible; the hold
	// length is the defender's one-way latency (0 at 0 ping -> instant, vanilla behavior).
	DefenderBM = MustModPawn(Info.HitActor);
	fHold = 0.0;
	if (!bCheckParryOnly
		&& DefenderBM != none
		&& !Info.DamageType.default.bIsProjectile
		&& Info.AttackType != Attack_Shove
		&& !IsOnSameTeam(self, Info.HitActor)
		&& !Info.HitActor.StateVariables.bIsParrying
		&& !Info.HitActor.StateVariables.bIsActiveShielding)
	{
		fHold = DefenderBM.GetParryHoldSeconds();
	}

	if (fHold > 0.0)
	{
		NewPending.fCommitTime = WorldInfo.TimeSeconds + fHold;
		NewPending.Attacker = self;
		NewPending.Info = Info;
		NewPending.DamageString = DamageString;
		NewPending.bBoxParrySuccess = bBoxParrySuccess;
		NewPending.bHitShield = bHitShield;
		NewPending.LastHit = LastHit;
		NewPending.bQuickKick = bQuickKick;
		NewPending.fActionServerTime = fHitActionServerTime;
		DefenderBM.PendingHits.AddItem(NewPending);
		return;
	}

	ProcessResolvedAttack(Info, DamageString, bCheckParryOnly, bBoxParrySuccess, bHitShield, LastHit, bQuickKick, false, fHitActionServerTime);
}

// MUSTMOD: The single commit path for a swing — damage, feedback, and replication applied at
// once. Called directly from AttackOtherPawn (no hold needed), or from ProcessPendingHits /
// ResolvePendingHitsAsParry once a held swing's fate is decided. 'self' is the ATTACKER.
// When bForceParry is true the swing resolves as a parry (the defender parried while this swing
// was held); DetectSuccessfulParry still rejects illegal parries (e.g. back hits), which then
// fall through to a normal hit. Nothing is ever played and then undone.
function ProcessResolvedAttack(HitInfo Info, string DamageString, optional bool bCheckParryOnly = false, optional bool bBoxParrySuccess = false, optional bool bHitShield = false, optional SwingTypeImpactSound LastHit = ESWINGSOUND_Slash, optional bool bQuickKick = false, optional bool bForceParry = false, optional float fActionServerTime = 0.0)
{
	local bool bParry;
	local float ActualDamage;
	local bool bSameTeam;
	local bool bFlinch;
	local IAOCAIListener AIList;
	local int i;
	local float Resistance;
	local float GenericDamage;
	local float HitForceMag;
	local PlayerReplicationInfo PRI;
	local bool bOnFire;
	local bool bPassiveBlock;
	local AOCWeaponAttachment HitActorWeaponAttachment;
	local MustModMeleeWeapon DefendingMeleeWeapon;
	local class<AOCWeapon> UsedWeapon;
	local TraceHitInfo THI;
	local bool bEnemyWasBot;
	local bool bWasKilled;
	local float StaminaAtKill;
	local bool bParryActive;
	local float fTimeSinceParryStart;
	local bool bBallistaBolt;

	// Initialise player replication information
	if (PlayerReplicationInfo == none)
		PRI = Info.PRI;
	else
		PRI = PlayerReplicationInfo;

	Info.PRI = PRI;
	bBallistaBolt = (Info.DamageType == class'AOCDmgType_BallistaBolt');

	// MUSTMOD: Client-timestamp trade priority. If THIS opponent hit us (or has a swing held on
	// us that will hit) clearly before our own swing landed — beyond fTradeWindowSeconds — the
	// trade is too staggered, so drop our swing and let whoever connected first win. Swings
	// within the window still trade. Only real enemy melee swings are eligible; parries (those
	// resolve via bForceParry), kicks, projectiles, team hits and ripostes are never cancelled.
	// Replaces the disabled ping-estimate "Fair trade window" block below.
	if (!bCheckParryOnly
		&& !bForceParry
		&& bEnableTradeCancellation
		&& fActionServerTime > 0.0
		&& Info.HitActor != none
		&& MustModPawn(Info.HitActor) != none
		&& !Info.DamageType.default.bIsProjectile
		&& Info.AttackType != Attack_Shove
		&& !IsOnSameTeam(self, Info.HitActor)
		&& !IsRiposteAttack()
		&& ShouldCancelTradeSwing(MustModPawn(Info.HitActor), fActionServerTime))
	{
		if (bShowHitTime && AOCPlayerController(Controller) != none)
			AOCPlayerController(Controller).ClientDisplayConsoleMessage("Trade swing cancelled (opponent hit first)");
		return;
	}

	// MustMod: Ping-normalized trade window for fair competitive play
	// Goal: Remove ping advantage for players under 70ms
	// 
	// How it works:
	// 1. When you get flinched, record the timestamp
	// 2. When YOUR hit arrives at server, calculate:
	//    - How long ago were you flinched? (flinch_duration)
	//    - What's the attacker's ping? (their_ping)
	//    - What's your ping? (my_ping)
	// 3. Fair trade window = their_ping + my_ping (round-trip time)
	// 4. If flinch_duration < fair_window AND both players <70ms ping:
	//    -> ALLOW the trade (simultaneous aggression)
	// 5. If flinch_duration > fair_window:
	//    -> BLOCK the attack (they clearly hit first)
	//
	// Example with 24ms vs 64ms ping:
	// - High ping player (64ms) gets hit first on their screen
	// - Their attack arrives 64ms later at server
	// - Low ping player (24ms) attack arrives 24ms later
	// - Fair window = 64ms + 24ms = 88ms
	// - If low-ping player was flinched <88ms ago, both hits count (trade)
	// - If >88ms ago, only high-ping player's hit counts (they won)
	// if (MustModMeleeWeapon(Weapon) != none && 
	//     MustModMeleeWeapon(Weapon).IsInState('Flinch'))
	// {
	// 	// How long have we been flinched?
	// 	fFlinchDuration = WorldInfo.TimeSeconds - MustModMeleeWeapon(Weapon).fFlinchStateStartTime;
		
	// 	// Get both players' ping in seconds (ExactPing is in seconds, Ping is in 0-250 range)
	// 	fAttackerPing = PlayerReplicationInfo != none ? PlayerReplicationInfo.ExactPing : 0.060;
	// 	fDefenderPing = Info.HitActor.PlayerReplicationInfo != none ? Info.HitActor.PlayerReplicationInfo.ExactPing : 0.060;
		
	// 	// Fair trade window = round-trip time between both players, capped at 200ms
	// 	// Dynamic examples:
	// 	//   24ms + 64ms = 88ms (competitive fair trade)
	// 	//   24ms + 100ms = 124ms (low vs high ping)
	// 	//   100ms + 100ms = 200ms (capped, high ping slugfest)
	// 	// This punishes high ping players: their delayed attacks get canceled more often
	// 	fFairTradeWindow = FMin(fAttackerPing + fDefenderPing, 0.100);
		
	// 	// Apply to ALL ping ranges (no threshold check)
	// 	// If we've been flinched LONGER than the fair trade window,
	// 	// the other player clearly hit first - block our attack
	// 	if (fFlinchDuration > fFairTradeWindow)
	// 	{
	// 		// They hit us well before we swung - not a trade, just late
	// 		return;
	// 	}
	// 	// Otherwise, flinch_duration <= fair_window means our attacks were
	// 	// simultaneous considering network latency - allow the trade
	// }

	// Select weapon (not sure this is necessary...?)
	if (Info.UsedWeapon == 0)
		UsedWeapon = PrimaryWeapon;
	else if (Info.UsedWeapon == 1)
		UsedWeapon = SecondaryWeapon;
	else
		UsedWeapon = TertiaryWeapon;

	HitActorWeaponAttachment = AOCWeaponAttachment(Info.HitActor.CurrentWeaponAttachment);
	DefendingMeleeWeapon = MustModMeleeWeapon(Info.HitActor.Weapon);

	// Is the player on the same team?
	bSameTeam = IsOnSameTeam(self, Info.HitActor);

	bFlinch = false;

	// Server-side parry validation - honor either the live parry flags or a fresh
	// authoritative Parry state whose booleans have not serialized yet.
	bParryActive = Info.HitActor.StateVariables.bIsParrying || Info.HitActor.StateVariables.bIsActiveShielding;
	if (!bParryActive && DefendingMeleeWeapon != none && Info.HitActor.Weapon.IsInState('Parry'))
	{
		fTimeSinceParryStart = WorldInfo.TimeSeconds - DefendingMeleeWeapon.fServerParryStartTime;
		if (fTimeSinceParryStart > 0 && fTimeSinceParryStart <= DefendingMeleeWeapon.fParryGracePeriod)
		{
			bParryActive = true;
		}
	}
	
	bParry = (CheckProjectileParry(Info) || bBoxParrySuccess || bForceParry)
			 && bParryActive
			 && class<AOCDmgType_Generic>(Info.DamageType) == none
			 && Info.DamageType != class'AOCDmgType_SiegeWeapon';

	// Only fists can block fists
	if (AOCWeapon_Fists(Info.HitActor.Weapon) != none && class<AOCDmgType_Fists>(Info.DamageType) == none)
		bParry = false;

	// Cause pawn to lose stamina, get stunned etc
	// If DetectSuccessfulParry returns false (e.g. butt-parry blocked), treat as a normal hit
	// so that damage and flinch are applied as if the defender wasn't parrying.
	if (bParry)
		if (!DetectSuccessfulParry(Info, i, bCheckParryOnly, 0))
			bParry = false;

	if (Info.DamageType.default.bIsProjectile && !bParry)
		AOCPRI(PlayerReplicationInfo).NumHits += 1;

	// Check for passive shield block
	bPassiveBlock = false;
	if (bHitShield && Info.DamageType.default.bIsProjectile) {
		bParry = true;
		Info.HitDamage = 0.0f;
		bPassiveBlock = !Info.HitActor.StateVariables.bIsActiveShielding;
	}

	if (bCheckParryOnly)
		return;

	// Play correct hit sound depending on parry success/failure
	AOCWeaponAttachment(CurrentWeaponAttachment).LastSwingType = LastHit;
	if(!bParry) {
		Info.HitActor.OnActionFailed(EACT_Block);
		Info.HitSound = AOCWeaponAttachment(CurrentWeaponAttachment).PlayHitPawnSound(Info.HitActor);
	} else
		Info.HitSound = AOCWeaponAttachment(CurrentWeaponAttachment).PlayHitPawnSound(Info.HitActor, true);

	// Register the hit on the AOCMeleeWeapon class
	if (AOCMeleeWeapon(Info.Instigator.Weapon) != none)
	{
		AOCMeleeWeapon(Info.Instigator.Weapon).bHitPawn = true;

		// Grand Lance: self-flinch the attacker on successful enemy stab hit
		if (!bSameTeam && Info.AttackType == Attack_Stab
			&& !bParry
			&& MustModWeapon_GrandLance(Info.Instigator.Weapon) != none)
		{
			AOCWeapon(Info.Instigator.Weapon).ActivateFlinch(true, Info.Instigator.GetHitDirection(Location), false, false, true);
		}
	}

	// Less damage for quick kick
	if (bQuickKick)
		Info.HitDamage = 0;

	// Calculate damage of the attack
	ActualDamage = Info.HitDamage;
	GenericDamage = Info.HitDamage * Info.DamageType.default.DamageType[EDMG_Generic];
	ActualDamage -= GenericDamage; //Generic damage is unaffected by resistances etc.

	//Backstab damage for melee damage
	if (!CheckOtherPawnFacingMe(Info.HitActor) && !Info.DamageType.default.bIsProjectile && !bParry)
		ActualDamage *= PawnFamily.fBackstabModifier;

	// If the hit was in a critical location, increase the damage
	if (Info.UsedWeapon == 0 && MustModWeapon_Crossbow(Weapon) != none && Info.DamageType.default.bIsProjectile)
		ActualDamage *= Info.HitActor.PawnFamily.CrossbowLocationModifiers[GetBoneLocation(Info.BoneName)];
	else
		ActualDamage *= (Info.DamageType.default.bIsProjectile ? Info.HitActor.PawnFamily.ProjectileLocationModifiers[GetBoneLocation(Info.BoneName)] :
			Info.HitActor.PawnFamily.LocationModifiers[GetBoneLocation(Info.BoneName)]);

	// Apply resistances
	Resistance = 0;
	for(i = 0; i < ArrayCount(Info.DamageType.default.DamageType); i++)
		Resistance += Info.DamageType.default.DamageType[i] * Info.HitActor.PawnFamily.DamageResistances[i];
	ActualDamage *= Resistance;

	// If this was a team hit, reduce by team damage amount
	if (PawnFamily.FamilyFaction == Info.HitActor.PawnFamily.FamilyFaction)
		ActualDamage *= AOCGame(WorldInfo.Game).fTeamDamagePercent;

	ActualDamage += GenericDamage;

	// Finally, round the result and finish up
	ActualDamage = float(Round(ActualDamage));

	// Ballista damage set on the map/siege actor overrides projectile defaults, so clamp it here
	// in the shared pawn hit path where the final damage is actually applied.
	if (bBallistaBolt)
	{
		ActualDamage = 50.0f;
		// Info.HitForce = vect(0.0f, 0.0f, 0.0f);
	}

	// Stun if the parry costs too much stamina
	if (bParry && !bPassiveBlock && Info.HitActor.Stamina <= 0) {
		bFlinch = true;
		AOCWeapon(Info.HitActor.Weapon).ActivateFlinch(true, Info.HitActor.GetHitDirection(Location), true, true, AOCWeapon(Weapon).bTwoHander);
	}

	// If the other pawn is currently attacking, we just conducted a counter-attack
	if (Info.AttackType == Attack_Shove && !bParry && !Info.HitActor.StateVariables.bIsSprintAttack) {
		if (!bSameTeam) {
			if (Info.Instigator.StateVariables.bShieldEquipped && Info.HitActor.StateVariables.bIsActiveShielding && !bQuickKick) {
				// If it was a heavy shield bash against raised shield, do full stun
				bFlinch = true;
				AOCWeapon(Info.HitActor.Weapon).ActivateFlinch(true, Info.HitActor.GetHitDirection(Location),true, true, false);
			} else if (!Info.HitActor.StateVariables.bIsActiveShielding)
				// If they aren't active shielding, activate normal kick flinch
				AOCWeapon(Info.HitActor.Weapon).ActivateFlinch(true, Info.HitActor.GetHitDirection(Location), false, false, true);

			// If they got stamina stunned, regain stamina
			if (Info.HitActor.StateVariables.bIsActiveShielding && Info.HitActor.Stamina <= 0)
				Info.HitActor.ConsumeStamina(-30.0f);
		}
	}
	// If they weren't parrying or shielding, apply flinch (but not during riposte)
	else if ((Info.HitActor.StateVariables.bIsParrying || Info.HitActor.StateVariables.bIsActiveShielding) && !bParry && !IsInRiposte(Info.HitActor)) {
		bFlinch = true;
		AOCWeapon(Info.HitActor.Weapon).ActivateFlinch(true, Info.HitActor.GetHitDirection(Location), false, false, AOCWeapon(Weapon).bTwoHander);
	}
	// If flinch needs to be activated...
	else if ((ShouldActivateFlinch(Info, UsedWeapon) || AOCWeapon_Fists(Info.Instigator.Weapon) != none) && !bParry) {
		// Flinch victim on enemy hits, flinch both attacker and victim on team hits
		if (bSameTeam) {
			// Custom: Flinch both attacker and teammate (punishment for team damage)
			AOCWeapon(Weapon).ActivateFlinch(true, GetHitDirection(Info.HitActor.Location), false, false, AOCWeapon(Info.HitActor.Weapon).bTwoHander);
			AOCWeapon(Info.HitActor.Weapon).ActivateFlinch(true, Info.HitActor.GetHitDirection(Location), false, false, AOCWeapon(Weapon).bTwoHander);
		} else {
			// Flinch enemy victim normally
			AOCWeapon(Info.HitActor.Weapon).ActivateFlinch(true, Info.HitActor.GetHitDirection(Location), false, false, AOCWeapon(Weapon).bTwoHander);
		}
	}
	// Otherwise we landed a hit on the enemy, play hit animation
	else if (!bParry && !bSameTeam && AOCWeapon_JavelinThrow(Info.HitActor.Weapon) == none)
		AOCWeapon(Info.HitActor.Weapon).ActivateHitAnim(Info.HitActor.GetHitDirection(Location, false, true), bSameTeam);

	// Remnants of god mode. TODO: Is this redundant?
	if (Info.HitActor.bInfiniteHealth)
		ActualDamage = 0.0f;

	// If the hit caused damage
	if (ActualDamage > 0.0f) {
		// Register the effects on the pawn
		Info.HitActor.SetHitDebuff();
		LastAttackedBy = Info.Instigator;
		PauseHealthRegeneration();
		Info.HitActor.PauseHealthRegeneration();
		Info.HitActor.DisableSprint(true);
		Info.HitActor.StartSprintRecovery();

		// Play a ping sound if we hit a player when shooting (ranged is immediate)
		if (Info.DamageType.default.bIsProjectile)
			PlayRangedHitSound();
		else if (!bSameTeam)
			PlayMeleeHit();

		// Read health BEFORE TakeDamage so the death scream isn't doubled with the hit grunt.
		if (Info.HitActor.Health - ActualDamage > 0.0f)
			Info.HitActor.PlayHitSounds(ActualDamage, bFlinch);

		// Register the hit on the player countroller
		if (AOCPlayerController(Controller) != none)
			AOCPlayerController(Controller).PC_SuccessfulHit();

		// Add to assist list if the pawn isn't already in it
		if (Info.HitActor.ContributingDamagers.Find(AOCPRI(PlayerReplicationInfo)) == INDEX_NONE && !bSameTeam)
			Info.HitActor.ContributingDamagers.AddItem(AOCPRI(PlayerReplicationInfo));

		Info.HitActor.LastPawnToHurtYou = Controller;

		// Allow the last pawn to attack to be a potential killer:
		// This applies when the player commits suicide (e.g falldamage, trap)
		if( AOCDuel(WorldInfo.Game) == none || CDWDuel(WorldInfo.Game) == none )
			Info.HitActor.SetTimer(10.f, false, 'ClearLastPawnToAttack');

		// If it was a projectile, do more stuff
		if (Info.DamageType.default.bIsProjectile)
			Info.HitActor.StruckByProjectile(self, UsedWeapon);
	}


	// Notify Pawn that we hit
	if (AOCMeleeWeapon(Weapon) != none && Info.HitActor.Health - ActualDamage > 0.0f && Info.AttackType != Attack_Shove && Info.AttackType != Attack_Sprint && !bParry)
		AOCMeleeWeapon(Weapon).NotifyHitPawn();

	// Replicate the attack information to the clients
	Info.bParry = bParry;
	Info.DamageString = DamageString;
	// Where did the hit take place at? Was it a projectile?
	if (Info.BoneName == 'b_Neck' && !Info.DamageType.default.bIsProjectile && Info.DamageType.default.bCanDecap && Info.AttackType != Attack_Stab)
		Info.DamageString $= "3";
	// Check for headshot (by decapitation)
	else if ((Info.BoneName == 'b_Neck' || Info.BoneName == 'b_Head') && Info.DamageType.default.bIsProjectile) {
		Info.DamageString $= "4";

		if ( AOCPlayerController(Controller) != none)
			AOCPlayerController(Controller).NotifyAchievementHeadshot();
	}
	// Did it hit the spine?
	else if ((Info.BoneName == 'b_spine_A' || Info.BoneName == 'b_spine_B' || Info.BoneName == 'b_spine_C' || Info.BoneName == 'b_spine_D') && Info.DamageType.default.bIsProjectile) {
		if ( AOCPlayerController(Controller) != none)
			AOCPlayerController(Controller).NotifyCupidProgress();
	}

	// Fill out the rest of the values
	// Replicate to clients (repnotify -> HandlePawnGetHit: blood, impact sound, crosshair).
	Info.HitActor.ReplicatedHitInfo = Info;
	Info.HitDamage = ActualDamage;
	Info.HitForce *= int(PawnState != ESTATE_PUSH && PawnState != ESTATE_BATTERING);
	Info.HitForce *= int(!bFlinch);
	HitForceMag = VSize( Info.HitForce );
	Info.HitForce.Z = 0.f;
	Info.HitForce = Normal(Info.HitForce) * HitForceMag;

	// Track statistics for each weapon
	if (PRI != none) {
		// Register non-team damage
		if (!bSameTeam)
			AOCPRI(PRI).EnemyDamageDealt += ActualDamage;
		// Register team damage with the PlayerController
		else
			if (Info.HitActor.PawnInfo.myFamily.ClassReference != ECLASS_Peasant
				&& Info.HitActor.PlayerReplicationInfo != PRI) {
				// TeamDamageDealt is repurposed for successful parry counting (scoreboard "Prys" column)
				// AOCPlayerController.TeamDamageDealt still tracks TDmg for the penalty system
				AOCPlayerController(Controller).TeamDamageDealt += ActualDamage;
			}

		// Force an update
		AOCPRI(PRI).bForceNetUpdate = TRUE;
	}

	// Replicate this information
	if (Info.HitActor.PlayerReplicationInfo != none) {
		AOCPRI(Info.HitActor.PlayerReplicationInfo).DamageTaken += ActualDamage;
		AOCPRI(Info.HitActor.PlayerReplicationInfo).bForceNetUpdate = TRUE;
	}

	// Is the target burning?
	bOnFire = Info.HitActor.bIsBurning;

	// Get the trace/hit info
	THI = MakeTraceHitInfoFromHitInfo(Info);

	// Was the target a bot?
	bEnemyWasBot = Info.HitActor.bIsBot || Info.HitActor.PlayerReplicationInfo.bBot || AOCPRI(Info.HitActor.PlayerReplicationInfo).bIsBot || AOCAIController(Info.HitActor.Controller) != none;

	// Apply damage once.
	Info.HitActor.TakeDamage(ActualDamage, Controller != none ? Controller : CurrentSiegeWeapon.Controller, Info.HitLocation, Info.HitForce, Info.DamageType, THI, self);

	// Was the enemy killed?
	bWasKilled = (Info.HitActor == none || Info.HitActor.Health <= 0);
	Info.HitActor.ReplicatedHitInfo.bWasKilled = bWasKilled;

	// If they were killed, regain stamina
	if(Info.HitActor.Health <= 0 && !bSameTeam) {

		// MAA gets extra stamina on kill
		if (PawnInfo.myFamily.ClassReference == ECLASS_ManAtArms) {
	        	Info.Instigator.ConsumeStamina(-50.f);
		} else {
			Info.Instigator.ConsumeStamina(-30.f);
		}
	        StaminaAtKill = Info.Instigator.Stamina;

		// Make sure that it doesn't exceed max stamina
	        if(StaminaAtKill > MaxStamina)
	            Info.Instigator.Stamina = MaxStamina;
	}

	if (bWasKilled && WorldInfo.NetMode == NM_DedicatedServer) {
		// Make sure this wasn't a team kill
		if (AOCPlayerController(Controller).StatWrapper != none
			&& !bSameTeam
			&& Info.UsedWeapon < 2
			&& !bEnemyWasBot) {

			// Increment kill stats
			AOCPlayerController(Controller).StatWrapper.IncrementKillStats(
				Info.UsedWeapon == 0 ? PrimaryWeapon : SecondaryWeapon,
				PawnFamily,
				Info.HitActor.PawnFamily,
				class<AOCWeapon>(HitActorWeaponAttachment.WeaponClass)
			);
		}

		// Do another check for a headshot here
		if (Info.BoneName == 'b_Neck' && !Info.DamageType.default.bIsProjectile && Info.DamageType.default.bCanDecap && Info.AttackType != Attack_Stab) {
			// Award rotiserie chef achievement on client
			if (AOCPlayerController(Controller) != none && bOnFire)
				AOCPlayerController(Controller).UnlockRotisserieChef();

			// Notify decap
			AOCPlayerController(Controller).NotifyAchievementDecap();
		}

		// Check if fists
		if (class<AOCDmgType_Fists>(Info.DamageType) != none)
			if (AOCPlayerController(Controller) != none)
				// Update achievement progress
				AOCPlayerController(Controller).NotifyFistofFuryProgress();
	}

	// Update the AI
	foreach AICombatInterests(AIList) {
		AIList.NotifyPawnPerformSuccessfulAttack(self);
	}

	// More AI stuff
	foreach Info.HitActor.AICombatInterests(AIList) {
		if (!bParry)
			AIList.NotifyPawnReceiveHit(Info.HitActor,self);
		else
			AIList.NotifyPawnSuccessBlock(Info.HitActor, self);
	}

	// Standalone/listen: replicate the hit reaction locally.
	if (WorldInfo.NetMode == NM_Standalone || Worldinfo.NetMode == NM_ListenServer)
	{
		Info.HitActor.HandlePawnGetHit();
	}

	// Firebug ignition — delayed so the blunt impact sound plays cleanly before
	// the fire scream SFX kicks in. Without the delay the scream drowns out the
	// weapon impact cue since both fire in the same frame on the same channel.
	if (MustModWeapon_Firebug(Weapon) != none && Info.HitActor != none
		&& ActualDamage > 0.0f && !bParry && !bSameTeam && !Info.HitActor.bIsBurning
		&& Info.HitActor.IsAliveAndWell())
	{
		SetTimer(0.25f, false, 'DelayedFirebugIgnite');
		StoredFirebugHitActor = Info.HitActor;
	}

	// MUSTMOD: Remember this hit on the victim so, if their counter-swing is still in flight, the
	// server can see it landed clearly later and drop it (trade priority). Real enemy melee hits
	// only — parries, kicks, projectiles and team hits don't gate a trade.
	if (!bParry && !bSameTeam
		&& bEnableTradeCancellation
		&& fActionServerTime > 0.0
		&& Info.HitActor != none
		&& MustModPawn(Info.HitActor) != none
		&& !Info.DamageType.default.bIsProjectile
		&& Info.AttackType != Attack_Shove)
	{
		MustModPawn(Info.HitActor).RecordIncomingHit(self, fActionServerTime);
	}
}



//debug release hit time
function Set_fLastReleaseStartTime(float set)
{
	fLastReleaseStartTime = set;
}

function Set_bShowHitTime(bool set)
{
	bShowHitTime = set;
}

// ===========================================================================================
// MUSTMOD: Client-timestamp hit-trade priority — helpers + client->server stamp RPCs.
// ===========================================================================================

// One-way latency in seconds. ExactPing is round-trip (seconds), so halve it. Capped so a
// spoofed/garbage ping can't push reconstructed action times arbitrarily far into the past.
function float GetOneWayPingSeconds()
{
	if (PlayerReplicationInfo != none)
		return FMin(PlayerReplicationInfo.ExactPing * 0.5, fMaxPlausibleLatency);

	return 0.0;
}

// Smooth the client->server clock offset from each stamped RPC. A stamp made ~one-way-ping ago
// in the client's clock should map to (now - oneWay) on the server timeline; the difference is
// the offset. EMA-smoothed so per-message queue jitter doesn't swing the estimate around.
function UpdateClockOffset(float fClientStamp)
{
	local float fSample;

	if (fClientStamp <= 0.0)
		return;

	fSample = (WorldInfo.TimeSeconds - GetOneWayPingSeconds()) - fClientStamp;

	if (!bClientClockOffsetInit)
	{
		fClientClockOffset = fSample;
		bClientClockOffsetInit = true;
	}
	else
	{
		fClientClockOffset = fClientClockOffset * (1.0 - fClockOffsetAlpha) + fSample * fClockOffsetAlpha;
	}
}

// MUSTMOD: Seed this pawn's client-clock offset from the controller's persisted value (carried
// from the player's previous pawn before it died). Lets the hit-trade timestamp system start
// warm on respawn instead of cold-starting into pure ping reconstruction. Called from
// MustModPlayerController.Possess. Server-only.
function SeedClockOffset(float fOffset)
{
	fClientClockOffset = fOffset;
	bClientClockOffsetInit = true;
}

// Map a client timestamp onto the server timeline. Falls back to pure ping reconstruction when
// no usable stamp/offset exists (bots, missing stamp). Clamped to a physically plausible window
// so a forged early/late stamp can't claim priority it didn't earn.
function float ReconstructActionTime(float fClientStamp)
{
	local float fResult, fNow;

	fNow = WorldInfo.TimeSeconds;

	if (fClientStamp <= 0.0 || !bClientClockOffsetInit)
		return fNow - GetOneWayPingSeconds();

	fResult = fClientStamp + fClientClockOffset;

	if (fResult > fNow)
		fResult = fNow;                              // can't have happened in the server's future
	else if (fResult < fNow - fMaxPlausibleLatency)
		fResult = fNow - fMaxPlausibleLatency;       // can't be older than max plausible latency

	return fResult;
}

// Drop taken-hit records older than the TTL so the trade window only sees recent hits.
function PruneRecentIncomingHits()
{
	local int i;
	local float fCutoff;

	fCutoff = WorldInfo.TimeSeconds - fRecentHitTTL;

	for (i = RecentIncomingHits.Length - 1; i >= 0; i--)
	{
		if (RecentIncomingHits[i].fActionServerTime < fCutoff)
			RecentIncomingHits.Remove(i, 1);
	}
}

// Remember a hit we just took (on the victim pawn) so a counter-swing still in flight can be
// recognised as a staggered trade and dropped.
function RecordIncomingHit(MustModPawn FromPawn, float fActionServerTime)
{
	local RecentIncomingHit NewEntry;

	if (FromPawn == none || fActionServerTime <= 0.0)
		return;

	PruneRecentIncomingHits();

	NewEntry.Attacker = FromPawn;
	NewEntry.fActionServerTime = fActionServerTime;
	RecentIncomingHits.AddItem(NewEntry);
}

// True when THIS pawn's current swing is a riposte (parry hit-counter attack). Ripostes are
// exempt from hit-trade cancellation so a deliberate parry counter always lands, even when it
// would otherwise line up as a staggered trade.
function bool IsRiposteAttack()
{
	return MustModMeleeWeapon(Weapon) != none && MustModMeleeWeapon(Weapon).bParryHitCounter;
}

// True when OUR swing should be dropped: this opponent hit us (or has a swing held on us that
// will hit) clearly earlier than our swing landed — beyond the trade window. Checking held
// swings too means the rollback hold can never let a staggered hit slip through as a trade.
function bool ShouldCancelTradeSwing(MustModPawn Opponent, float fSwingActionTime)
{
	local int i;

	if (Opponent == none || fSwingActionTime <= 0.0)
		return false;

	PruneRecentIncomingHits();

	for (i = 0; i < RecentIncomingHits.Length; i++)
	{
		if (RecentIncomingHits[i].Attacker == Opponent
			&& RecentIncomingHits[i].fActionServerTime > 0.0
			&& fSwingActionTime - RecentIncomingHits[i].fActionServerTime > fTradeWindowSeconds)
			return true;
	}

	for (i = 0; i < PendingHits.Length; i++)
	{
		if (PendingHits[i].Attacker == Opponent
			&& PendingHits[i].fActionServerTime > 0.0
			&& fSwingActionTime - PendingHits[i].fActionServerTime > fTradeWindowSeconds)
			return true;
	}

	return false;
}

// Best estimate (server timeline) of when this pawn's parry went active: the fresh client stamp
// if one just arrived, otherwise ping reconstruction from now.
function float GetParryActionServerTime()
{
	if (bClientClockOffsetInit
		&& fLastParryActionServerTime > 0.0
		&& WorldInfo.TimeSeconds - fLastParryStampServerTime < 0.25)
		return fLastParryActionServerTime;

	return WorldInfo.TimeSeconds - GetOneWayPingSeconds();
}

// Client reports the moment (its own clock) its swing connected. Sent on the pawn channel just
// before AttackOtherPawn (reliable -> ordered), so AttackOtherPawn reads a fresh stamp.
reliable server function ServerStampHitTime(float fClientHitTime)
{
	UpdateClockOffset(fClientHitTime);
	fPendingHitClientTime = fClientHitTime;
}

// Client reports the moment (its own clock) its parry went active, mapped + stored for the
// hit-vs-parry decision in ResolvePendingHitsAsParry.
reliable server function ServerStampParryTime(float fClientParryTime)
{
	UpdateClockOffset(fClientParryTime);
	fLastParryActionServerTime = ReconstructActionTime(fClientParryTime);
	fLastParryStampServerTime = WorldInfo.TimeSeconds;
}

// MUSTMOD: How long to hold an incoming swing on THIS (defender) pawn so an in-flight parry
// can still reach the server and suppress it. Equals the defender's one-way latency, capped.
// Returns 0 on LAN/bots (no network crossing to compensate) -> swings resolve instantly.
function float GetParryHoldSeconds()
{
	local float fPingSec;
	local float fHold;

	if (PlayerReplicationInfo != none)
		fPingSec = float(PlayerReplicationInfo.Ping) * 0.004; // UE3 stores ping as ms/4

	fHold = FMin(fPingSec, fParryRollbackMaxHoldSeconds);

	if (fHold < fParryRollbackMinHoldSeconds)
		return 0.0;

	return fHold;
}

// MUSTMOD: Commit held swings whose hold window elapsed without a parry. Runs on the defender
// (self) from Tick. Each commits exactly once through the normal hit path.
function ProcessPendingHits()
{
	local int i;
	local PendingHit Entry;
	local float fNow;

	if (PendingHits.Length == 0)
		return;

	fNow = WorldInfo.TimeSeconds;

	for (i = 0; i < PendingHits.Length; i++)
	{
		if (fNow >= PendingHits[i].fCommitTime)
		{
			Entry = PendingHits[i];
			PendingHits.Remove(i, 1);
			i--;

			if (Entry.Attacker != none && Entry.Attacker.Weapon != none)
				Entry.Attacker.ProcessResolvedAttack(Entry.Info, Entry.DamageString, false, Entry.bBoxParrySuccess, Entry.bHitShield, Entry.LastHit, Entry.bQuickKick, false, Entry.fActionServerTime);
		}
	}
}

// MUSTMOD: Delayed Firebug ignition — lets the blunt impact sound finish before the fire
// scream plays, so both audio cues are audible instead of the scream drowning out the impact.
function DelayedFirebugIgnite()
{
	if (StoredFirebugHitActor != none && StoredFirebugHitActor.IsAliveAndWell()
		&& !StoredFirebugHitActor.bIsBurning)
	{
		StoredFirebugHitActor.SetPawnOnFire(none, Controller, self, class'MustModDmgType_TorchBurn');
	}
	StoredFirebugHitActor = none;
}

// MUSTMOD: A parry landed while swings were still held on us — resolve every one as a parry
// BEFORE any hit feedback plays (decide-once). DetectSuccessfulParry still rejects illegal
// parries (e.g. back hits), which then fall through to a normal hit. Runs on the defender (self)
// from MustModMeleeWeapon.Parry.BeginState, after super sets bIsParrying/bIsActiveShielding.
// fParryActionServerTime is when the parry went active (server timeline); a held swing is only
// resolved as a parry if the parry wasn't clearly later than the swing (timestamp gate). Swings
// that the parry was too late for stay held and commit as normal hits when their hold expires.
function ResolvePendingHitsAsParry(optional float fParryActionServerTime = 0.0)
{
	local int i;
	local PendingHit Entry;

	if (PendingHits.Length == 0)
		return;

	for (i = 0; i < PendingHits.Length; i++)
	{
		Entry = PendingHits[i];

		// Timestamp gate: a genuine block is up before/around the hit; a panic parry fired well
		// after the hit landed (more than the grace) does not save the held swing.
		if (fParryActionServerTime > 0.0
			&& Entry.fActionServerTime > 0.0
			&& fParryActionServerTime - Entry.fActionServerTime > fParryTradeGraceSeconds)
		{
			continue;
		}

		if (Entry.Attacker != none && Entry.Attacker.Weapon != none)
			Entry.Attacker.ProcessResolvedAttack(Entry.Info, Entry.DamageString, false, Entry.bBoxParrySuccess, Entry.bHitShield, Entry.LastHit, Entry.bQuickKick, true, Entry.fActionServerTime);

		PendingHits.Remove(i, 1);
		i--;
	}
}



// Block ballista bolt SPLASH damage only. Direct hits still kill.
// Splash flows through HurtRadius → TakeRadiusDamage → TakeDamage with the
// projectile as DamageCauser. Direct hits go through AttackOtherPawn → TakeDamage
// with DamageCauser=none, so we let those through.
event TakeDamage(int Damage, Controller InstigatedBy, vector HitLocation, vector Momentum, class<DamageType> DamageType, optional TraceHitInfo HitInfo, optional Actor DamageCauser)
{
	if (DamageType == class'AOCDmgType_BallistaBolt' && AOCProjectile(DamageCauser) != none)
		return;

	// Firebug ignition moved to end of AttackOtherPawn (after HandlePawnGetHit)
	// so that the blunt impact sound plays before the fire sound.

	super.TakeDamage(Damage, InstigatedBy, HitLocation, Momentum, DamageType, HitInfo, DamageCauser);
}

// MUSTMOD: Suppress burning scream voice lines. Fire crackle SFX still plays via ActivateFireSFX.
simulated function ActivateBurnScream()
{
}

// Override to reset parry box to AOC defaults when MustMod parry box is disabled
simulated function AOCSetCharacterClassFromInfo(AOCFamilyInfo Info)
{
	super.AOCSetCharacterClassFromInfo(Info);

	// NOTE: Do NOT guard on Controller != none here. This function fires during pawn setup,
	// before the controller is associated, so that check would always fail and the reset
	// would never run on the server.
	if (!class'MustModAOCDuelPlayerController'.default.bMustModParryBox)
	{
		// Revert to vanilla AOC parry box dimensions
		ParryComponent.SetScale3D(vect(0.1, 0.17, 0.35));
		ParryComponent.SetTranslation(vect(30, 0, -30));
	}
	else if (class'MustModAOCDuelPlayerController'.default.bSkeletalParry)
	{
		// Skeletal parry: full-body coverage
		ParryComponent.SetScale3D(vect(0.18, 0.17, 0.35));
		ParryComponent.SetTranslation(vect(10, 5, -28));
	}
	// else: MustMod parry enabled, non-skeletal — super already applied FamilyInfo values

	// Apply admin-controlled collision bubble radius (OuterCylinder)
	if (OuterCylinderComp != none)
	{
		OuterCylinderComp.SetCylinderSize(class'MustModAOCDuelPlayerController'.default.fMustModCollisionRadius, 65.0);
	}
}

//netupdate
// function PossessedBy(Controller C, bool bVehicleTransition)
// {
// 	Super.PossessedBy(C, bVehicleTransition);
	
// 	// Spectators don't need 120Hz - save bandwidth with 60Hz (still smooth, ~50% reduction)
// 	if (PlayerReplicationInfo != none && PlayerReplicationInfo.bOnlySpectator)
// 		NetUpdateFrequency = 60.0;
// 	else
// 		NetUpdateFrequency = 120.0;
// }

// Netcode optimization: Maximum performance for all pawns
// 120Hz update frequency for all distances
event float GetNetPriority(Actor Viewer, vector ViewLocation, float ViewDist)
{
	// Always use maximum priority and frequency for all pawns
	NetUpdateFrequency = 120.0;
	return 5000.0;
}

// Reduce momentum loss when colliding with other pawns
event Bump( Actor Other, PrimitiveComponent OtherComp, Vector HitNormal )
{
	super.Bump(Other, OtherComp, HitNormal);

	// Preserve 50% of velocity when bumping into other pawns during normal movement
	// (Vanilla zeros velocity completely, causing excessive momentum loss)
	if (AOCPawn(Other) != none && !StateVariables.bIsSprintAttack && !bForceVelocity)
	{
		Velocity = Velocity * 1.0f;
		Acceleration = Acceleration * 1.0f;
	}
}

simulated function SetThirdPersonCamera(bool bNewBehindView)
{
	super.SetThirdPersonCamera(bNewBehindView);

	if (MustModWeaponAttachment_DualBucklers(CurrentWeaponAttachment) != none)
	{
		MustModWeaponAttachment_DualBucklers(CurrentWeaponAttachment).UpdateLeftHandVisibility(bNewBehindView);
	}

	if (MustModWeaponAttachment_WarHammer(CurrentWeaponAttachment) != none)
	{
		MustModWeaponAttachment_WarHammer(CurrentWeaponAttachment).UpdateLeftHandVisibility(bNewBehindView);
	}
}


// Default class properties

/* ************************************************************************
 * FIRST-PERSON SPECTATOR -- rebuild the stripped 1P mesh
 *
 * AOCPawn.SetCharacterAppearance() destroys the first-person OwnerMesh on any
 * pawn that was not locally controlled at the moment it loaded its character
 * assets (AOCPawn.uc ~11890):
 *
 *     if( IsLocallyControlled() || bIsBeingFPObserved )
 *     {
 *         ... OwnerMesh.SetAnimTreeTemplate(...);
 *         ... OwnerMesh.SetSkeletalMesh( AssetStore.OwnerMesh );
 *     }
 *     else if(Worldinfo.NetMode != NM_DedicatedServer || Controller != none)
 *     {
 *         DetachComponent(OwnerMesh);
 *         OwnerMesh = none;
 *     }
 *
 * That runs at spawn, long before anybody spectates, so bIsBeingFPObserved is
 * always false there. On a client that means EVERY other player's pawn -- human
 * or bot -- permanently loses its 1P mesh, and AOCPawn.BecomeFirstPersonObserved()
 * (which does OwnerMesh.SetSkeletalMesh(...)) can never work. Only pawns that are
 * locally controlled keep it, i.e. your own pawn, plus bots when you are the
 * listen-server/standalone host (server-side AI controllers count as local).
 *
 * The 1P skeletal mesh asset itself IS loaded on every client -- LoadCharacterAssets()
 * fetches OwnerMeshPath into CharacterAssetStore.OwnerMesh with no
 * locally-controlled gate -- so all that is missing is the component. We rebuild it
 * from the class-default archetype the first time a local spectator views this pawn.
 **************************************************************************/

/**
 * Recreates OwnerMesh if SetCharacterAppearance() stripped it. No-op when the
 * mesh is already present, so this is safe to call repeatedly.
 *
 * Returns TRUE if the pawn has a usable 1P mesh afterwards.
 *
 * The setup below deliberately mirrors SetCharacterAppearance()'s own OwnerMesh
 * branch, in the same order, because vanilla relies on SetAnimTreeTemplate() /
 * SetSkeletalMesh() firing PostInitAnimTree(OwnerMesh) to populate OwnerAimNode,
 * OwnerTopHalfSlot, OwnerBlendAnimationListNode and friends. There is no other
 * call site that assigns those.
 */
simulated function bool MustModEnsureOwnerMesh()
{
	local class<AOCCharacterInfo> Info;
	local AnimSet TempSet;
	local int i;

	if (OwnerMesh != none)
		return true;

	// Nothing to render on a dedicated server, and it never strips the mesh anyway.
	if (WorldInfo.NetMode == NM_DedicatedServer)
		return false;

	if (CharacterAssetStore == none || CharacterAssetStore.OwnerMesh == none)
		return false;

	Info = CharacterAssetStore.CharacterInfo;
	if (Info == none)
		return false;

	OwnerMesh = new(self) class'SkeletalMeshComponent' (default.OwnerMesh);
	if (OwnerMesh == none)
		return false;

	AttachComponent(OwnerMesh);

	// new(...)(Template) is a plain property copy -- it does NOT run component
	// instancing, so the LightEnvironment pointer we just copied still refers to the
	// class-default MyLightEnvironment subobject, which is not registered in the
	// world. Without this the rebuilt 1P mesh renders unlit (black).
	// Precedent: AOCWeaponAttachment.uc:258 does the same for ArrowComp.
	if (Mesh != none)
		OwnerMesh.SetLightEnvironment(Mesh.LightEnvironment);

	// Stay hidden until SetThirdPersonCamera(false) deliberately reveals it, so a
	// rebuilt mesh cannot flash on screen for a frame mid-setup.
	OwnerMesh.SetHidden(true);

	if (Info.default.OverrideOwnerMeshAnimTree != none)
		OwnerMesh.SetAnimTreeTemplate(Info.default.OverrideOwnerMeshAnimTree);
	else
		OwnerMesh.SetAnimTreeTemplate(default.OwnerMesh.AnimTreeTemplate);

	OwnerMesh.AnimSets = Info.default.AnimSets;
	foreach Info.default.FirstPersonAnimSets(TempSet)
		OwnerMesh.AnimSets.AddItem(TempSet);

	OwnerMesh.SetSkeletalMesh( CharacterAssetStore.OwnerMesh );

	for (i = 0; i < CharacterAssetStore.OwnerMesh.Materials.Length; ++i)
		OwnerMesh.SetMaterial(i, CharacterAssetStore.OwnerMesh.Materials[i]);

	// If PostInitAnimTree never fired, the anim nodes are unbound and the 1P mesh
	// would render as a static ref-pose. Back the whole thing out rather than
	// hand the spectator a broken view.
	if (OwnerAimNode == none || OwnerBlendAnimationListNode == none)
	{
		// NOTE: do NOT use the log macro (backtick-log) here. SlumpMod compiles with
		// FINAL_RELEASE defined, which makes Object.LogInternal private (Object.uc:1478,
		// the prevent_direct_calls define), so it fails to compile. LogAlwaysInternal is
		// the public equivalent and is what AOC itself uses. Every other log macro in
		// this repo is commented out for the same reason.
		LogAlwaysInternal(self@"MustModEnsureOwnerMesh: anim tree did not initialise (OwnerAimNode="$OwnerAimNode$", OwnerBlendAnimationListNode="$OwnerBlendAnimationListNode$") -- reverting");
		DetachComponent(OwnerMesh);
		OwnerMesh = none;
		return false;
	}

	LogAlwaysInternal(self@"MustModEnsureOwnerMesh: rebuilt 1P mesh"@CharacterAssetStore.OwnerMesh);
	return true;
}

/**
 * Rebuild the 1P mesh as soon as a local spectator starts viewing this pawn, so it
 * exists by the time MustModApplyFPObserve() runs on the controller side.
 *
 * BecomeViewTarget fires from the native SetViewTarget inside
 * PlayerController.ClientSetViewTarget, which is exactly one step ahead of where
 * MustModPlayerController applies the perspective.
 */
simulated event BecomeViewTarget(PlayerController PC)
{
	if (PC != none && PC.IsLocalPlayerController()
		&& AOCPlayerController(PC) != none && AOCPlayerController(PC).IsInState('Spectating'))
	{
		MustModEnsureOwnerMesh();
	}

	super.BecomeViewTarget(PC);
}


/* ************************************************************************
 * CAMERA SOCKET FALLBACK
 *
 * AOCPlayerCamera.UpdateCamera() derives the player's entire view from a socket
 * on a skeletal mesh:
 *
 *     OwnerPawn.GetCameraSocketLocationAndRotation(bFirstPerson, CameraLocation, CameraRotation);
 *
 * and AOCPawn's implementation forwards straight to the native
 * SkeletalMeshComponent.GetSocketWorldLocationAndRotation(). That native call
 * returns WITHOUT WRITING ITS OUT PARAMETERS when the component has no
 * SkeletalMesh -- it only emits
 * "Warning: GetSocketWorldLocationAndRotation : Could not find SkeletalMesh".
 *
 * So a missing first-person mesh does not produce a visible error: it silently
 * leaves CameraLocation / CameraRotation at whatever they last held, and the view
 * freezes there forever. Coming out of spectate that is the spectator camera,
 * hundreds of metres away -- the pawn plays normally underneath while the screen
 * shows a fixed corner of the map.
 *
 * This bit MustMod badly: several classes ship OwnerMeshPaths whose package was
 * not installed, and content packages live in the DLC folder, which a script cook
 * wipes. Rather than depend on every 1P asset always being present, degrade:
 *
 *     1P socket  ->  3P socket  ->  pawn eye position
 *
 * The 3P mesh is fully animated (it carries the aim offset), so the fallback view
 * still pitches and yaws with the player. It is not as clean as the real 1P
 * camera, but it is a working first-person view instead of a dead one.
 *
 * When the 1P mesh IS present this is byte-for-byte vanilla behaviour -- the first
 * branch below is the only one that runs.
 **************************************************************************/

/** True when this component can actually resolve CameraSocket. */
simulated function bool MustModCanUseCameraSocket(SkeletalMeshComponent SMC)
{
	return SMC != none
		&& SMC.SkeletalMesh != none
		&& SMC.GetSocketByName(CameraSocket) != none;
}

simulated function GetCameraSocketLocationAndRotation(bool bFirstPerson, out vector CameraLocation, out rotator CameraRotation)
{
	local SkeletalMeshComponent Wanted;

	// Seed the out params with an always-sane view BEFORE any native call.
	//
	// GetSocketWorldLocationAndRotation is declared to return bool and AOCPawn throws
	// that result away, so every way it can bail -- no SkeletalMesh, a socket whose
	// bone is missing, spacebases not yet valid -- leaves the caller's values
	// untouched. That is the whole bug: stale values read as a frozen camera. Pre-fill
	// them and a silent bail degrades to "camera at the pawn's eyes" instead.
	MustModEyeViewPoint(CameraLocation, CameraRotation);

	if (bFirstPerson)
		Wanted = OwnerMesh;
	else
		Wanted = Mesh;

	// Normal path: the mesh that was asked for can resolve the socket.
	if (MustModCanUseCameraSocket(Wanted))
	{
		super.GetCameraSocketLocationAndRotation(bFirstPerson, CameraLocation, CameraRotation);
		return;
	}

	// First person asked for but no usable 1P mesh -- borrow the 3P one. It is
	// animated, so aim pitch still works. AOCPlayerCamera zeroes roll for us on the
	// first-person path, so the 3P mesh's lean does not leak through.
	if (bFirstPerson && MustModCanUseCameraSocket(Mesh))
	{
		if (!bMustModWarnedNoOwnerMesh)
		{
			bMustModWarnedNoOwnerMesh = true;
			LogAlwaysInternal(self@"MustMod: no usable 1P camera mesh (OwnerMesh="$OwnerMesh$"), falling back to the 3P camera socket.");
		}

		super.GetCameraSocketLocationAndRotation(false, CameraLocation, CameraRotation);

		// Take only the POSITION from the 3P socket. Its rotation is baked with the
		// locomotion animation -- strafe lean, footstep sway, turn-in-place -- which the
		// 1P mesh deliberately lacks. Feeding that to the view swings the camera around
		// independently of where the player is aiming: forward movement jerks left and
		// right, and W+A / W+D rotate the view instead of strafing.
		//
		// Deliberately NOT GetBaseAimRotation(): it calls Controller.GetPlayerViewPoint,
		// which comes straight back here via AOCPlayerCamera.UpdateCamera.
		MustModAimRotation(CameraRotation);
		return;
	}

	// Neither mesh is usable. The seed above already holds the eye view point.
	if (!bMustModWarnedNoCameraSocket)
	{
		bMustModWarnedNoCameraSocket = true;
		LogAlwaysInternal(self@"MustMod: no usable camera socket on either mesh; using the pawn's eye position.");
	}
}

/** Where this pawn is looking, without re-entering the camera path. */
simulated function MustModAimRotation(out rotator OutRot)
{
	if (Controller != none)
	{
		OutRot = Controller.Rotation;
		return;
	}

	// Remote pawn (someone we are spectating): Pawn.Controller only replicates to its
	// owner, and Rotation carries yaw only -- pitch arrives as RemoteViewPitch.
	OutRot = Rotation;
	if (OutRot.Pitch == 0)
		OutRot.Pitch = RemoteViewPitch << 8;
}

/** Last-resort view point: the pawn's own eyes. Never leaves the caller holding stale values. */
simulated function MustModEyeViewPoint(out vector OutLoc, out rotator OutRot)
{
	OutLoc = Location;
	OutLoc.Z += EyeHeight;
	MustModAimRotation(OutRot);
}

/* ************************************************************************
 * STOCK 1P MESH SUBSTITUTION
 *
 * Several MustMod classes set OwnerMeshPath to an object in a content package that
 * is not installed at runtime, so CharacterAssetStore.OwnerMesh comes back none and
 * the player has no first-person arms at all.
 *
 * Every one of those classes already draws its THIRD-person mesh from a stock
 * Chivalry package that loads fine, and the stock packages also contain the
 * matching first-person mesh. So when the configured 1P mesh is missing, fall back
 * to the stock one for that class rather than leaving the player empty-handed.
 *
 * This only ever runs when the configured mesh failed to load -- if the custom
 * package is ever installed properly, the custom arms are used and none of this
 * executes.
 **************************************************************************/

/** Object name from a "Package.Object" or "Package.Group.Object" path. */
simulated function string MustModObjectName(string Path)
{
	local int i;

	// bSearchFromRight = true, so "Pkg.Group.Object" yields "Object".
	i = InStr(Path, ".", true);

	if (i == INDEX_NONE)
		return Path;

	return Mid(Path, i + 1);
}

/**
 * Stock Chivalry 1P mesh for a class whose configured OwnerMeshPath did not load.
 * Each mapping is the OwnerMeshPath that the matching vanilla AOCCharacterInfo_*
 * class ships with, so these are the arms Chivalry itself uses for that character.
 *
 * Matched on the OBJECT NAME only, deliberately ignoring the package. The custom
 * character package has been renamed once already (SlumpCharacters -> MustmodCharacters)
 * and the classes are currently split across both spellings, so keying on the full
 * path would silently stop matching the moment either name moves again.
 */
simulated function SkeletalMesh MustModStock1PMesh(class<AOCCharacterInfo> Info)
{
	local string Want, Path;

	if (Info == none)
		return none;

	Want = MustModObjectName(Info.default.OwnerMeshPath);

	// Knights
	if (Want ~= "AgathaKnight1p")
		Path = "CH_AgathanKnight_PKG.models.SK_CH_1P_AgathaKnight";
	else if (Want ~= "AgathaKnightDLC1p")
		Path = "CH_AgathaKnight_DLC1.models.SK_Char_knight_FP";
	else if (Want ~= "MasonKnight1p")
		Path = "CH_MasonKnight.models.SK_CH_1P_MasonKnight";
	else if (Want ~= "MasonKnightDLC1p")
		Path = "CH_MasonKnight_DLC1.models.SK_Char_knight_FP";

	// Vanguards
	else if (Want ~= "AgathaVanguard1p")
		Path = "CH_A_Vanguard_PKG.PlayerviewTEMP_agatha";
	else if (Want ~= "AgathaVanguardDLC1p")
		Path = "CH_AgathaVanguard_DLC1.models.SK_CH_1P_AgathaVanguard01";
	else if (Want ~= "MasonVanguard1p")
		Path = "CH_A_Vanguard_PKG.PlayerviewTEMP";
	else if (Want ~= "MasonVanguardDLC1p")
		Path = "CH_MasonVanguard_DLC1.models.SK_CH_1P_MasonVanguard_DLC1";

	// Barbarian variants
	else if (Want ~= "AgathaBarbArcher1p")
		Path = "CH_Barb_AgathaArcher.models.SK_CH_1P_Barb_AgathaArcher";
	else if (Want ~= "AgathaBarb1p")
		Path = "CH_Barb_AgathaKnight.models.SK_CH_1P_Barb_AgathaKnight";
	else if (Want ~= "AgathaBarbVanguard1p")
		Path = "CH_Barb_AgathaVanguard.models.SK_CH_1P_Barb_AgathaVanguard";
	else if (Want ~= "MArcherBarb1p")
		Path = "CH_Barb_MasonArcher.models.SK_CH_1P_Barb_MasonArcher";
	else if (Want ~= "MasonBarb1p")
		Path = "CH_Barb_MasonKnight.models.SK_CH_1P_Barb_MasonKnight";
	else if (Want ~= "MasonBarbVanguard1p")
		Path = "CH_Barb_MasonVanguard.models.SK_CH_1P_Barb_MasonVanguard";

	if (Path == "")
		return none;

	// MayFail = true: if a stock package is somehow absent too, stay silent and let
	// the camera fallback handle it rather than spamming.
	return SkeletalMesh(DynamicLoadObject(Path, class'SkeletalMesh', true));
}

simulated function SetCharacterAppearance(AssetStore_AOCPawn_Character AssetStore)
{
	local SkeletalMesh Stock;
	local int i;

	// Substitute only when the store is genuinely missing the mesh it was asked for.
	// Comparing the paths as well as testing for none matters because AssetStore.Clear()
	// resets LoadedObjects/PendingObjects but never nulls OwnerMesh -- a store reused
	// for a different character could otherwise keep the previous class's arms.
	if (AssetStore != none
		&& AssetStore.CharacterInfo != none
		&& AssetStore.OwnerMesh == none
		&& AssetStore.OwnerMeshPath ~= AssetStore.CharacterInfo.default.OwnerMeshPath)
	{
		Stock = MustModStock1PMesh(AssetStore.CharacterInfo);

		if (Stock != none)
		{
			AssetStore.OwnerMesh = Stock;

			if (!bMustModWarnedStock1PMesh)
			{
				bMustModWarnedStock1PMesh = true;
				LogAlwaysInternal(self@"MustMod: 1P mesh"@AssetStore.CharacterInfo.default.OwnerMeshPath@"did not load; substituting stock"@Stock);
			}
		}
	}

	super.SetCharacterAppearance(AssetStore);

	// Assassin first-person arms tint: AOCPawn.SetCharacterAppearance only applies
	// HeadMaterialPath/BodyMaterialPath to the THIRD-person mesh. The owner (1P) mesh
	// keeps whatever material is baked into it, and the DW Ninja arms mesh ships with
	// a neutral grey baked material, so the arms render grey instead of team colours.
	// Re-tint every owner-mesh slot with the faction body material (NinjaBodyAgathaMat /
	// NinjaBodyMasonMat) for the two Assassin characters. Scoped so no other class is
	// affected. Also keyed on the CharacterInfo and BodyMaterial actually being loaded.
	if (AssetStore != none
		&& AssetStore.CharacterInfo != none
		&& OwnerMesh != none
		&& AssetStore.OwnerMesh != none
		&& AssetStore.BodyMaterial != none
		&& (AssetStore.CharacterInfo == class'MustModCharacterInfo_Agatha_Assassin'
			|| AssetStore.CharacterInfo == class'MustModCharacterInfo_Mason_Assassin'))
	{
		for (i = 0; i < AssetStore.OwnerMesh.Materials.Length; ++i)
		{
			OwnerMesh.SetMaterial(i, AssetStore.BodyMaterial);
		}
	}
}


/* ************************************************************************
 * FEINT / BLEND RESET WHILE FIRST-PERSON OBSERVED
 *
 * AOCPawn.ResetBlends() opens with:
 *
 *   if (bReplicated && WorldInfo.NetMode != NM_DedicatedServer
 *       && ((IsLocallyControlled() && !bIsBot) || bIsBeingFPObserved))
 *       return;
 *
 * The bIsBeingFPObserved half assumes a first-person-observed pawn is OUR pawn, so
 * the local reset (bReplicated = false) has already run and the replicated one is
 * redundant. That holds for your own pawn. It is false for a remote pawn you are
 * spectating: nothing on this client ever ran the local reset.
 *
 * A feint goes ManualReset() -> replicate SResetBlends -> remote clients receive it
 * in ReplicatedEvent and call ResetBlends(ResetTime) with bReplicated defaulted TRUE
 * (AOCPawn.uc:1634). For the pawn we are first-person observing that call returns
 * immediately, the blends are never cleared, and the weapon stays stuck in its
 * feinted pose on the spectator's screen.
 *
 * Run it as a local reset rather than skipping it.
 **************************************************************************/
simulated function ResetBlends(optional float BlendOutTime = 0.3f, optional bool bReplicated = true)
{
	if (bReplicated && bIsBeingFPObserved && !IsLocallyControlled())
	{
		// bReplicated = false clears vanilla's early-out and performs the real reset,
		// which also calls AOCWeaponAttachment.ResetAnimation() -- the bit that puts
		// the weapon back to idle.
		super.ResetBlends(BlendOutTime, false);
		return;
	}

	super.ResetBlends(BlendOutTime, bReplicated);
}

/* ************************************************************************
 * WEAPON-KEYED NINJA (ASSASSIN) SKIN
 *
 * Picking one of the archer's "ninja" primary weapons (SpikedMace, BastardSword,
 * Kanabo, Katana, GrandHammer -- indexes 6..10 in
 * MustModFamilyInfo_*_Archer) makes the pawn spawn with the Assassin (ninja)
 * mesh instead of the archer mesh, with no new UI slot and no Flash asset.
 *
 * The Assassin presentation already exists and is fully registered:
 *   - MustModCharacterInfo_Agatha_Assassin / _Mason_Assassin (SlumpCharacters.NinjaMesh*)
 *   - MustModCustomizationContent.GetDefaultCharacterIDFor maps ECLASS_SiegeEngineer
 *     -> the faction Assassin CharacterInfo.
 *
 * AOCPawn.LoadCharacterAssets() resolves the mesh from
 * PawnInfo.myCustomization.Character; we simply rewrite that ID before the
 * superclass runs. LoadCharacterAssets is per-pawn and simulated, so the same
 * remap runs on the server and on every client.
 **************************************************************************/

/** True when the equipped primary is one of the archer's ninja weapons. */
simulated function bool MustModIsNinjaPrimary()
{
	return PawnInfo.myPrimary == class'MustModWeapon_BastardSword'
		|| PawnInfo.myPrimary == class'MustModWeapon_Kanabo'
		|| PawnInfo.myPrimary == class'MustModWeapon_Katana'
		|| PawnInfo.myPrimary == class'MustModWeapon_GrandHammer';
}

/** Rewrite the character ID to the Assassin before the character mesh is loaded. */
simulated function LoadCharacterAssets()
{
	local EAOCFaction TeamID;

	if (PawnFamily != none && MustModIsNinjaPrimary())
	{
		TeamID = GetCustomizationFactionFromActualFaction(PawnFamily.FamilyFaction);
		PawnInfo.myCustomization.Character =
			CustomizationClass.static.GetDefaultCharacterID(TeamID, ECLASS_SiegeEngineer);

		// The archer's saved helmet index resolves against the Assassin's helmet
		// list, which points at a different (wrong) helmet. NoHat keeps it clean.
		PawnInfo.myCustomization.Helmet = 0;
	}

	super.LoadCharacterAssets();
}

DefaultProperties
{
	HealthTimeElapse=0.0
	HealAmount=3.0

	fSuccessiveParryStaminaReward=30
    fSuccessiveParryThresholdSeconds=1

	// Parry rollback: hold an incoming swing up to this long (capped at defender one-way ping)
	// so an in-flight parry can suppress it before any feedback plays. 0 hold at 0 ping.
	fParryRollbackMaxHoldSeconds=0.059
	fParryRollbackMinHoldSeconds=0.013

	// Client-timestamp hit-trade priority (see helpers/arbitration in this include).
	// Larger fTradeWindowSeconds keeps MORE trades; smaller cancels more staggered ones.
	fTradeWindowSeconds=0.025     // hits within 25ms (~3 frames at 120Hz) still trade
	fParryTradeGraceSeconds=0.059  // a parry counts unless it went active >51ms after the swing landed (~6 frames at 120Hz)
	fMaxPlausibleLatency=0.500     // clamp for reconstructed client timestamps / one-way ping
	fRecentHitTTL=0.200            // how long a taken hit stays eligible to cancel a trade swing
	fClockOffsetAlpha=0.10         // EMA weight for per-message clock-offset samples
	bEnableTradeCancellation=true  // master toggle: hit-trade cancellation; false disables it

	// Riposte flinch immunity grace period - 300ms after successful parry
	// Prevents flinch during Parry->ParryRelease state transition (network desync)
	// Increased from 200ms to 300ms for better high-ping protection
	// Damage grace period disabled.
	// fRiposteGracePeriod=0.300

	// Netcode optimization: 120Hz server->client pawn updates (matches server tickrate and ReplicateMove rate)
	NetUpdateFrequency=120

	CustomizationClass=class'MustModCustomization'

	OuterCylinderComp=OuterCylinder

	Begin Object Name=OuterCylinder
	    CollisionRadius=+0039.000000
	    CollisionHeight=+0065.000000
	    BlockNonZeroExtent=true
	    BlockZeroExtent=false
	    BlockActors=true
	    CollideActors=true
	    bDrawBoundingBox=false
	    BlockNonTeamActors=true
	End Object

	Begin Object Name=CollisionCylinder
		BlockZeroExtent=FALSE
		AlwaysCheckCollision=true
		CollisionRadius=+0036.000000
		CollisionHeight=+0065.000000
	End Object
}
